                    <Label Content="Create New Project" Margin="102,0,102,32" VerticalAlignment="Bottom" Foreground="#FF496180" FontFamily="Arial" FontSize="16" FontWeight="Bold" HorizontalContentAlignment="Center"/>
                    <Image Height="60" Margin="153,36,155,0" VerticalAlignment="Top" Width="52" Source="Images/001-add-documents@3x.png"/>
                </Grid>
