                <Button HorizontalAlignment="Right" Margin="20,0,0,0" Width="75" BorderBrush="#FF1378FF" Foreground="White" FontFamily="Arial"  BorderThickness="1,1,0,1" Command="{Binding ScanAddressCommand}" Height="24" FontSize="14"
                        ToolTip="Only Support I2C Devices">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Background" Value="#FF1378FF"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Margin="-1">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4,0,0,4" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Margin="0,1" />
