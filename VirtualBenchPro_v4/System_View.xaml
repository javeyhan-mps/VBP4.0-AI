                                <Run Text="Scan:" FontWeight="Bold"/>
                                <Run Text="Will list out addresses connected to MPS adapter and let you assign device." />
                            </TextBlock>
                            <TextBlock Grid.Column="1" Grid.Row="1" TextWrapping="Wrap" Foreground="#FF9EACBF" FontFamily="Arial" FontSize="14" VerticalAlignment="Center">
                                <Run Text="Connect Manually:" FontWeight="Bold"/>
