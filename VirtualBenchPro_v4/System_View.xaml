                                            <Border Background="{TemplateBinding Background}" CornerRadius="0,4,4,0" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Margin="0,1" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
