                                                <Image Source="Images/auto-scan@3x.png" Width="12" Margin="0,0,4,0" Height="12" />
                                                <Label Content="Scan" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Foreground="White" Padding="0" FontSize="14" />
                                            </StackPanel>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF03C2FF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button HorizontalAlignment="Right" Margin="0" Width="160" BorderBrush="#FF1378FF" Foreground="#FF1378FF" FontFamily="Arial"  BorderThickness="1" Command="{Binding DataContext.deviceViewModel.AddDeviceCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}}" Height="24" FontSize="14" >
