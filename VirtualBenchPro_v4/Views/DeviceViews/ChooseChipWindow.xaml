<Window x:Class="VirtualBenchPro_v4.Views.DeviceViews.ChooseChipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VirtualBenchPro_v4.Views.DeviceViews"
        mc:Ignorable="d"
        Height="450" Width="450"  WindowStartupLocation="CenterScreen" WindowStyle="None" Background="#00000000" AllowsTransparency="True" ResizeMode="NoResize" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" >
    <Window.Resources>
        <ResourceDictionary>
            <RoutedCommand x:Key="Login_Command"/>
        </ResourceDictionary>
    </Window.Resources>
    <Window.CommandBindings>
        <CommandBinding Command="{StaticResource Login_Command}" CanExecute="Login_OnCanExecute" Executed="Login_Execute"/>
    </Window.CommandBindings>
    <Border Margin="25,25" CornerRadius="5" Background="White"  Padding="0" >
        <Border.Effect>
            <DropShadowEffect Direction="0" BlurRadius="20" ShadowDepth="0" Opacity="0.35" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseDown="Grid_MouseDown">
                <Border BorderThickness="0,0,0,1" BorderBrush="#FFE9EDF2" MouseDown="Grid_MouseDown"/>
                <Label x:Name="Help_Title_Label" VerticalContentAlignment="Center" FontSize="14" Foreground="#FF0A3C7F" Panel.ZIndex="2" Padding="0,5,5,5" Margin="16,0,33,0" FontFamily="Arial" Content="Please select device" FontWeight="Bold"/>
                <Button AutomationProperties.AutomationId="Choose_Chip_Close" x:Name="Close_Button" BorderBrush="{x:Null}" Click="Close_Button_Click" Width="20" HorizontalAlignment="Right" Margin="0,6,8,6" Height="20" BorderThickness="0" Panel.ZIndex="2" >
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Grid Background="{TemplateBinding Background}">
                                            <Image VerticalAlignment="Stretch" Source="/VirtualBenchPro_v4;component/Images/close@3x.png" Width="8" Height="8" />
                                            <!--<Image VerticalAlignment="Stretch"  Width="8" Height="8" />-->
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="5,0,0,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="46"/>
                </Grid.RowDefinitions>
                <ScrollViewer Width="auto" Height="auto" VerticalScrollBarVisibility="Hidden">
                    <Grid Margin="0,5,0,5" HorizontalAlignment="Left">
                        <Grid Width="180" Height="24" Margin="18,0,0,0">
                            <TextBlock x:Name="watermark_tb" Padding="5,0,24,0" VerticalAlignment="Center" Background="Transparent" Foreground="Gray" 
                                       FontSize="12" FontFamily="Arial" Text="Search" >
                                <TextBlock.Visibility>
                                    <MultiBinding Converter="{StaticResource NonValidationTextBoxWaterMarkVisibilityConveter}">
                                        <Binding ElementName="SearchTextBox" Path="IsFocused" />
                                        <Binding ElementName="SearchTextBox" Path="Text" />
                                    </MultiBinding>
                                </TextBlock.Visibility>
                            </TextBlock>
                        </Grid>
                        <TextBox x:Name="SearchTextBox" Width="180" Height="24" Margin="18,0,0,0" VerticalContentAlignment="Center" HorizontalAlignment="Left" Padding="3,0,22,0" Foreground="#FF496180" FontSize="14" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                             KeyDown="SearchTextBox_KeyDown" Background="Transparent" >
                            <TextBox.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <Button Command="{Binding FilterChipComand}" Cursor="Hand" Width="22" Height="22" Margin="0,1,1,1" BorderBrush="{x:Null}" BorderThickness="0"  
                                HorizontalAlignment="Right" FocusVisualStyle="{x:Null}">
                            <Button.ToolTip>
                                <ToolTip BorderBrush="Transparent" Background="Transparent">
                                    <Border CornerRadius="5" Background="#FF0A3C7F">
                                        <TextBlock TextWrapping="Wrap" FontFamily="Arial" Foreground="White" Margin="5" Background="Transparent" Text="Search Device" MaxWidth="300"/>
                                    </Border>
                                </ToolTip>
                            </Button.ToolTip>
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                                                    <!--<Label Content="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" Padding="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Foreground="{TemplateBinding Foreground}" FontStretch="Expanded"/>-->
                                                    <ContentPresenter Content="{TemplateBinding Content}"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFE6F9FF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Canvas Name = "SearchIcon" Width="14" Height="17" Background="Transparent">
                                <Path Name="Cicle" StrokeThickness="1" Stroke="#FF9EACBF" Data="M0 4.5C0 2.01472 2.01472 0 4.5 0C6.98528 0 9 2.01472 9 4.5C9 6.98528 6.98528 9 4.5 9C2.01472 9 0 6.98528 0 4.5Z">
                                    <Path.RenderTransform>
                                        <TranslateTransform X="1" Y="1"/>
                                    </Path.RenderTransform>
                                </Path>
                                <Path Name="Line" StrokeThickness="1" Stroke="#FF9EACBF" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M5 6L0 0">
                                    <Path.RenderTransform>
                                        <MatrixTransform Matrix="-1 0 0 -1 13 16"/>
                                    </Path.RenderTransform>
                                </Path>
                                <!--<Canvas.RenderTransform>
                                <RotateTransform Angle="75" CenterY="8" CenterX="7"/>
                            </Canvas.RenderTransform>-->
                            </Canvas>
                        </Button>
                    </Grid>
                </ScrollViewer>
                <ListBox AutomationProperties.AutomationId="Choose_Chip_List" FontFamily="Arial" Grid.Row="1" Grid.ColumnSpan="3" Margin="5,0,0,0" ItemsSource="{Binding FilteredChipList}" SelectedValue="{Binding SelectedChip}" BorderBrush="{x:Null}" Foreground="#FF496180" FontSize="14">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="Foreground" Value="#FF496180" />
                            <Setter Property="Margin" Value="3" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="radioList" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                <RadioButton.Content>
                                    <ContentPresenter Content="{Binding }" RecognizesAccessKey="False" />
                                </RadioButton.Content>
                            </RadioButton>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <DockPanel Grid.Row="2" Grid.Column="0">
                    <Button x:Name="Next_Button" AutomationProperties.AutomationId="Choose_Chip_Next" Style="{StaticResource ButtonRoundedBlue}" Grid.Row="1" FontFamily="Arial" Grid.Column="2" Content="Next" Margin="3,3,20,3" 
                            Command="{StaticResource Login_Command}" CommandParameter="{Binding}" Foreground="White" BorderBrush="#FF1C4EFF"
                            BorderThickness="0" Width="90" DockPanel.Dock="Right" HorizontalContentAlignment="Center" HorizontalAlignment="Right" Height="34" 
                            FontSize="16" />
                    <Button AutomationProperties.AutomationId="Choose_Chip_Cancel" Style="{StaticResource ButtonRoundedWhite }" Grid.Row="1" FontFamily="Arial" Grid.Column="1" Content="Cancel" Margin="3" IsCancel="True" 
                            Width="105" DockPanel.Dock="Right" HorizontalAlignment="Right" Height="34" FontSize="16" Foreground="#FF858585"/>
                   
                </DockPanel>
            </Grid>

        </Grid>

    </Border>

</Window>

