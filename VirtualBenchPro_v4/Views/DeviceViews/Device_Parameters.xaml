<Page x:Class="VirtualBenchPro_v4.Views.DeviceViews.Device_Parameters"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VirtualBenchPro_v4.Views.DeviceViews"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      mc:Ignorable="d" 
      MinHeight="564" MinWidth="489"
      Title="Device_Parameters">
    <Grid Background="White">
        <TabControl BorderBrush="{x:Null}">
            <TabItem Header="Device Parameters" Style="{StaticResource TabItem_HeaderButton}">
                <Grid Background="White">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="0.4*"/>
                        <RowDefinition Height="0.6*"/>
                    </Grid.RowDefinitions>
                </Grid>
            </TabItem>
            <TabItem Header="Test" Style="{StaticResource TabItem_HeaderButton}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="234"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                       
                        <Grid Grid.Row="0">
                            <Grid Height="52" VerticalAlignment="Top" Margin="8,8,8,0">
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Frame Content=""/>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid Margin="10,0,10,10">
                            <Label Content="Sequencing" VerticalAlignment="Top" Background="#FFD8D8D8" Foreground="White" Height="22" Padding="6,0,0,0" VerticalContentAlignment="Center" FontFamily="Arial"/>
                            <Grid Margin="0,22,0,0" Panel.ZIndex="5">
                                <Label Content="Start Up" HorizontalAlignment="Left" Margin="17,8,0,0" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" Padding="0" Foreground="{StaticResource TextColor}"/>
                                <Button x:Name="Sequencing_Start_CH0_Button" Style="{StaticResource ButtonDownRounded}" Content="CH 0" HorizontalAlignment="Left" Margin="60,0,0,0" VerticalAlignment="Top" Width="38" Panel.ZIndex="5" Height="20" FontFamily="Arial" FontSize="9" Background="White" BorderBrush="#FFD8D8D8" BorderThickness="1,0,1,1"/>
                                <Button x:Name="Sequencing_Start_CH1_Button" Style="{StaticResource ButtonDownRounded}" Content="CH 1" HorizontalAlignment="Left" Margin="100,0,0,0" VerticalAlignment="Top" Width="38" Panel.ZIndex="5" Height="20" FontFamily="Arial" FontSize="9" Background="White" BorderBrush="#FFD8D8D8"/>
                                <Button x:Name="Sequencing_Start_CH2_Button" Style="{StaticResource ButtonDownRounded}" Content="CH 2" HorizontalAlignment="Left" Margin="140,0,0,0" VerticalAlignment="Top" Width="38" Panel.ZIndex="5" Height="20" FontFamily="Arial" FontSize="9" Background="White" BorderBrush="#FFD8D8D8"/>
                                <Button x:Name="Sequencing_Start_CH3_Button" Style="{StaticResource ButtonDownRounded}" Content="CH 3" HorizontalAlignment="Left" Margin="180,0,0,0" VerticalAlignment="Top" Width="38" Panel.ZIndex="5" Height="20" FontFamily="Arial" FontSize="9" Background="White" BorderBrush="#FFD8D8D8"/>

                                <!-- https://lvcharts.net/ -->
                                <!--<lvc:CartesianChart Series="{Binding SeriesCollection}" Margin="10,25,10,32" >
                                    <lvc:CartesianChart.AxisY>
                                        <lvc:Axis ShowLabels="False" MinValue="0" MaxValue="100"/>
                                    </lvc:CartesianChart.AxisY>
                                    <lvc:CartesianChart.AxisX>
                                        <lvc:Axis ShowLabels="False" MinValue="0" MaxValue="1000"/>
                                    </lvc:CartesianChart.AxisX>
                                </lvc:CartesianChart>-->

                                <Slider x:Name="Ton_Slider" AutoToolTipPlacement="TopLeft" HorizontalAlignment="Left" Margin="10,0,0,20" VerticalAlignment="Bottom" Width="178" Maximum="{Binding Ton_Max}" SmallChange="1"/>
                                <Label Content="ton min = 00.00ms" HorizontalAlignment="Left" Margin="10,0,0,6" VerticalAlignment="Bottom" Padding="0" FontFamily="Arial" FontSize="8" Foreground="#FF6D7278"/>
                                <Label HorizontalAlignment="Left" Margin="115,0,0,6" VerticalAlignment="Bottom" Padding="0" FontFamily="Arial" FontSize="8" Foreground="#FF6D7278">
                                    <Label.Content>
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}ton max = {0}ms">
                                                    <Binding Path="Ton_Max" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Label.Content>
                                </Label>

                                <Slider x:Name="Toff_Slider" AutoToolTipPlacement="TopLeft" HorizontalAlignment="Right" Margin="0,0,10,20" VerticalAlignment="Bottom" Width="178" Maximum="{Binding Toff_Max}" SmallChange="1" />
                                <Label Content="toff min = 00.00ms"  HorizontalAlignment="Right" Margin="0,0,118,6" VerticalAlignment="Bottom" Padding="0" FontFamily="Arial" FontSize="8" Foreground="#FF6D7278"/>
                                <Label HorizontalAlignment="Right" Margin="0,0,10,6" VerticalAlignment="Bottom" Padding="0" FontFamily="Arial" FontSize="8" Foreground="#FF6D7278">
                                    <Label.Content>
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}toff max = {0}ms">
                                                    <Binding Path="Toff_Max" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Label.Content>
                                </Label>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

    </Grid>
</Page>
