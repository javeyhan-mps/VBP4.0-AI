<Window x:Class="VirtualBenchPro_v4.Views.DeviceViews.WinAbout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VirtualBenchPro_v4.Views.DeviceViews"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" Background="#00000000" AllowsTransparency="True" Width="405" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="309"  >

        <Border Margin="5" CornerRadius="5" Background="White"  >
            <Border.Effect>
                <DropShadowEffect Color="#FFE9EDF2" Direction="0" BlurRadius="10" ShadowDepth="0" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" >
                    <Border BorderThickness="0,0,0,1" BorderBrush="#FFE9EDF2" />
                <Label VerticalContentAlignment="Center" FontSize="14" Foreground="#FF0A3C7F" Panel.ZIndex="2" Padding="0,5,5,5" Margin="16,0,33,0" FontWeight="Bold" FontFamily="Arial" Content="About Virtual Bench Pro"/>
            </Grid>

                <Grid Grid.Row="1" Margin="0" >
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0 30 0 0">
                    <TextBlock Grid.Row="1" Text="{Binding AppVersion}" Margin="10" FontSize="15" Foreground="#FF0A3C7F" FontFamily="Arial"/>
                    <TextBlock Grid.Row="0" Text=""  FontFamily="Arial" FontSize="15" />
                    <TextBlock Grid.Row="2" Text="{Binding AppCopyright}" FontFamily="Arial" FontSize="15" Margin="10" Foreground="#FF0A3C7F"/>
                    <!--<TextBlock Grid.Row="2" Text="Copyright © Monolithic Power Systems 2025" FontFamily="Arial" FontSize="15" Margin="10" Foreground="#FF0A3C7F"/>-->
                </StackPanel>

                <Button Style="{StaticResource ButtonRoundedBlue}" FontFamily="Arial" Content="OK" Margin="0,0,16,24" 
                                Foreground="White" BorderBrush="#FF1C4EFF"
                                BorderThickness="0" Width="97" DockPanel.Dock="Right" HorizontalContentAlignment="Center" HorizontalAlignment="Right" Height="34" 
                                FontSize="16" VerticalAlignment="Bottom" IsCancel="True" />
                </Grid>

        </Grid>

        </Border>


    <!--<Grid>

            <TextBlock Grid.Row="1" Text="{Binding AppVersion}" Margin="20,10" FontSize="18"/>
            <TextBlock Grid.Row="0" Text=""  FontFamily="Verdana" FontSize="18" />
            <TextBlock Grid.Row="2" Text="Copyright © Monolithic Power Systems 2020" FontFamily="Verdana" FontSize="10" Margin="25,10,0,5"/>

        </Grid>
        <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Content="OK" Margin="3" Width="100" IsCancel="True" />
        </StackPanel>
    </Grid>-->
    
    
    
</Window>
