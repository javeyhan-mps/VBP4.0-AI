<Window x:Class="VirtualBenchPro_v4.Views.DeviceViews.WinUpdate"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VirtualBenchPro_v4.Views.DeviceViews"
        mc:Ignorable="d"
         WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" Background="#00000000" AllowsTransparency="True" Width="450" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="200"  >
    <Border Margin="5" CornerRadius="5" Background="White"  >
        <Border.Effect>
            <DropShadowEffect Color="#FFE9EDF2" Direction="0" BlurRadius="10" ShadowDepth="0" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" >
                <Border BorderThickness="0,0,0,1" BorderBrush="#FFE9EDF2" />
                <Label VerticalContentAlignment="Center" FontSize="14" Foreground="#FF0A3C7F" Panel.ZIndex="2" Padding="0,5,5,5" Margin="16 0" FontWeight="Bold" FontFamily="Arial" Content="Update to new version?"/>
            </Grid>

            <TextBlock Name="content" Grid.Row="1" TextWrapping="Wrap" FontFamily="Arial" FontSize="15" Margin="10 30 10 10" Foreground="#FF0A3C7F" HorizontalAlignment="Center"/>

            <GroupBox Grid.Row="2" Width="170" Height="50" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,8" BorderBrush="#FFE9EDF2">
                <GroupBox.Header>
                    <TextBlock Text="Choose Update Server"  Foreground="#FF496180" FontWeight="Bold"/>
                </GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="Radio_US" Content="US Server" Margin="5,5,0,5"/>
                    <RadioButton x:Name="Radio_CN" Content="CN Server" Margin="5,5,0,5"/>
                </StackPanel>
            </GroupBox>
            <TextBlock x:Name="TextBlock_Status" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,20,0" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,8" VerticalAlignment="Bottom" >
                <Button Style="{StaticResource ButtonRoundedBlue}" FontFamily="Arial" Content="OK" 
                                Foreground="White" BorderBrush="#FF1C4EFF"
                                BorderThickness="0" Width="97" DockPanel.Dock="Right" HorizontalContentAlignment="Center" HorizontalAlignment="Right" Height="34" 
                                FontSize="16" VerticalAlignment="Bottom" Click="btnOkClick" Margin="0,0,20,0"  />
                <Button Style="{StaticResource ButtonRoundedBlue}" FontFamily="Arial" Content="Cancel"  
                                Foreground="White" BorderBrush="#FF1C4EFF"
                                BorderThickness="0" Width="97" DockPanel.Dock="Right" HorizontalContentAlignment="Center" HorizontalAlignment="Right" Height="34" 
                                FontSize="16" VerticalAlignment="Bottom" IsCancel="True"  />
            
            </StackPanel>


        </Grid>

    </Border>
</Window>
