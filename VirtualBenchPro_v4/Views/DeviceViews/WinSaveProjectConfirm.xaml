<Window x:Class="VirtualBenchPro_v4.Views.DeviceViews.WinSaveProjectConfirm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VirtualBenchPro_v4.Views.DeviceViews"
        mc:Ignorable="d"
        Title="WinSaveProjectConfirm"  WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" Background="#00000000" AllowsTransparency="True" Width="500" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="220">
    <Border Margin="5" CornerRadius="5" Background="White"  >
        <Border.Effect>
            <DropShadowEffect Color="#FFE9EDF2" Direction="0" BlurRadius="10" ShadowDepth="0" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" >
                <Border BorderThickness="0,0,0,1" BorderBrush="#FFE9EDF2" />
                <Label VerticalContentAlignment="Center" FontSize="14" Foreground="#FF0A3C7F" Panel.ZIndex="2" Padding="0,5,5,5" Margin="20,0,33,0" FontWeight="Bold" FontFamily="Arial" Content="Virtual Bench Pro Save Project"/>
                <Button x:Name="Close_Button" BorderBrush="{x:Null}" Click="Close_Button_Click" Width="20" HorizontalAlignment="Right" Margin="0,6,8,6" Height="20" BorderThickness="0" Panel.ZIndex="2" >
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Grid Background="{TemplateBinding Background}">
                                            <Image VerticalAlignment="Stretch" Source="/VirtualBenchPro_v4;component/Images/close@3x.png" Width="8" Height="8" />
                                            <!--<Image VerticalAlignment="Stretch"  Width="8" Height="8" />-->
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="0" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="55*"/>
                    <ColumnDefinition Width="45*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="number_tb" Text="Please save your current project and close all opened parts. We can't proceed with any opened part." Grid.Row="0" Grid.RowSpan="4" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center" 
                           TextWrapping="Wrap" FontFamily="Arial" FontSize="15" Margin="30 0 40 0" Foreground="#FF0A3C7F" />


                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="4" Grid.ColumnSpan="2" Margin="0 0 0 0">
                    <Button x:Name="OK_button" Style="{StaticResource ButtonRoundedBlue}" Grid.Row="1" FontFamily="Arial" Grid.Column="2" Content="OK" Margin="10,3,20,3" 
                            Foreground="White" BorderBrush="#FF1C4EFF" BorderThickness="0" Width="110" DockPanel.Dock="Right" HorizontalContentAlignment="Center" HorizontalAlignment="Right" Height="34" 
                            FontSize="16"  Cursor="Hand" Click="OK_button_Click" />
                </StackPanel>
            </Grid>

        </Grid>

    </Border>
</Window>
