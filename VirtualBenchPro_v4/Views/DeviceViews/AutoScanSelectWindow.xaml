<Window x:Class="VirtualBenchPro_v4.Views.DeviceViews.AutoScanSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VirtualBenchPro_v4.Views.DeviceViews"
        mc:Ignorable="d"
        Height="450" Width="450" AutomationProperties.AutomationId="AutoScan_Window" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="#00000000" AllowsTransparency="True" ResizeMode="NoResize" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" >
    <Window.Resources>
        <ResourceDictionary>
            <RoutedCommand x:Key="Login_Command"/>
        </ResourceDictionary>
    </Window.Resources>
    <Window.CommandBindings>
        <CommandBinding Command="{StaticResource Login_Command}" CanExecute="Login_OnCanExecute" Executed="Login_Execute"/>
    </Window.CommandBindings>
    <Border Margin="25,25" CornerRadius="5" Background="White"  Padding="0" >
        <Border.Effect>
            <DropShadowEffect Direction="0" BlurRadius="20" ShadowDepth="0" Opacity="0.35" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseDown="Grid_MouseDown">
                <Border BorderThickness="0,0,0,1" BorderBrush="#FFE9EDF2" MouseDown="Grid_MouseDown"/>
                <Label x:Name="Title_Label" VerticalContentAlignment="Center" FontSize="14" Foreground="#FF0A3C7F" Panel.ZIndex="2" Padding="0,5,5,5" Margin="16,0,33,0" FontFamily="Arial"  FontWeight="Bold"/>
                <Button AutomationProperties.AutomationId="Auto_Scan_Close" x:Name="Close_Button" BorderBrush="{x:Null}" Click="Close_Button_Click" Width="20" HorizontalAlignment="Right" Margin="0,6,8,6" Height="20" BorderThickness="0" Panel.ZIndex="2" >
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Grid Background="{TemplateBinding Background}">
                                            <Image VerticalAlignment="Stretch" Source="/VirtualBenchPro_v4;component/Images/close@3x.png" Width="8" Height="8" />
                                            <!--<Image VerticalAlignment="Stretch"  Width="8" Height="8" />-->
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="5,0,0,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="80" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="60"/>
                </Grid.RowDefinitions>

                <TextBlock Name="Info_TextBlock" TextWrapping="Wrap" FontFamily="Arial" Grid.Row="0" Margin="10 20 10 10" FontSize="14" Foreground="#FF496180"/>

                <ListBox AutomationProperties.AutomationId="Auto_Scan_List" Name="chip_ListBox" FontFamily="Arial" Grid.Row="1" Grid.ColumnSpan="3"  ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionMode="Multiple" Margin="20 5" BorderBrush="{x:Null}"  >
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="Foreground" Value="#FF496180" />
                            <Setter Property="Margin" Value="2" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Style="{StaticResource AutoScanCheckBoxStyle}"  FocusVisualStyle="{x:Null}"  IsChecked="{Binding IsSelected}">
                                <CheckBox.Content>
                                    <MultiBinding Converter="{StaticResource ChipNameAddrConverter}">
                                        <Binding Path="ChipName" />
                                        <Binding Path="ChipAddr" />
                                    </MultiBinding>
                                </CheckBox.Content>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <DockPanel Grid.Row="2" Grid.Column="0">
                    <Button AutomationProperties.AutomationId="Auto_Scan_Next" x:Name="Func_Button" Style="{StaticResource ButtonRoundedBlue}" Grid.Row="1"  Command="{StaticResource Login_Command}" CommandParameter="{Binding}" FontFamily="Arial" Grid.Column="2" Margin="3,3,20,3" Foreground="White" BorderBrush="#FF1C4EFF" BorderThickness="0" Width="120" DockPanel.Dock="Right" HorizontalContentAlignment="Center" HorizontalAlignment="Right" Height="34" FontSize="16"  />
                    <Button AutomationProperties.AutomationId="Auto_Scan_Cancel" Style="{StaticResource ButtonRoundedWhite}" Grid.Row="1" FontFamily="Arial" Grid.Column="1" Content="Cancel" Margin="3" IsCancel="True"  Width="105" DockPanel.Dock="Right" HorizontalAlignment="Right" Height="34" FontSize="16" BorderBrush="Gray" Foreground="Gray"/>
                </DockPanel>
            </Grid>

        </Grid>

    </Border>
</Window>
