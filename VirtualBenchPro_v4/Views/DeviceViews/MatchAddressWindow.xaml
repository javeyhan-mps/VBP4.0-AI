<Window x:Class="VirtualBenchPro_v4.Views.DeviceViews.MatchAddressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VirtualBenchPro_v4.Views.DeviceViews"
         xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        mc:Ignorable="d"
        Height="620" Width="500" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="#00000000" AllowsTransparency="True" ResizeMode="NoResize" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" x:Name="matchwindow">
    <Window.Resources>
        <ResourceDictionary>
            <RoutedCommand x:Key="Login_Command1"/>
        </ResourceDictionary>
    </Window.Resources>
    <Window.CommandBindings>
        <CommandBinding Command="{StaticResource Login_Command1}" CanExecute="Login_OnCanExecute" Executed="Login_Execute"/>
    </Window.CommandBindings>
    <Border Margin="25,25" CornerRadius="5" Background="White"  Padding="0" >
        <Border.Effect>
            <DropShadowEffect Direction="0" BlurRadius="20" ShadowDepth="0" Opacity="0.35" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseDown="Grid_MouseDown">
                <Border BorderThickness="0,0,0,1" BorderBrush="#FFE9EDF2" MouseDown="Grid_MouseDown"/>
                <Label x:Name="Help_Title_Label" VerticalContentAlignment="Center" FontSize="14" Foreground="#FF0A3C7F" Panel.ZIndex="2" Padding="0,5,5,5" Margin="16,0,33,0" FontFamily="Arial" Content="Please select Address" FontWeight="Bold"/>
                <Button x:Name="Close_Button" AutomationProperties.AutomationId="Match_Address_Close" BorderBrush="{x:Null}" Click="Close_Button_Click" Width="20" HorizontalAlignment="Right" Margin="0,6,8,6" Height="20" BorderThickness="0" Panel.ZIndex="2" >
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Grid Background="{TemplateBinding Background}">
                                            <Image VerticalAlignment="Stretch" Source="/VirtualBenchPro_v4;component/Images/close@3x.png" Width="8" Height="8" />
                                            <!--<Image VerticalAlignment="Stretch"  Width="8" Height="8" />-->
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>


            <DockPanel LastChildFill="True" Grid.Row="1" Background="#F6FAFE">
                <ScrollViewer VerticalScrollBarVisibility="Auto" DockPanel.Dock="Top" MaxHeight="200" Margin="10 10 10 10">
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"   FontFamily="Arial" Foreground="#FF496180" HorizontalAlignment="Center"/>
                </ScrollViewer>
                <TextBlock Text="{Binding AddressList_Title}" Visibility="{Binding Normal_Visibility}" HorizontalAlignment="Center" DockPanel.Dock="Top" FontFamily="Arial" Foreground="#FF496180" FontWeight="Bold"/>
                <DataGrid x:Name="Register_Map_DataGrid"  Visibility="{Binding Normal_Visibility}" ItemsSource="{Binding AddrVsROhmsList}" BorderBrush="#FFE9EDF2"  SelectionMode="Single" 
                          AlternationCount="2" Style="{DynamicResource DGHeaderForMatchAddressStyle}" AutoGenerateColumns="False" IsReadOnly="True" HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center" CanUserAddRows="False" CanUserResizeColumns="False" CanUserResizeRows="False" Background="Transparent" HorizontalAlignment="Center"
                          EnableRowVirtualization="False" HeadersVisibility="Column" GridLinesVisibility="None"  CanUserReorderColumns="False" Margin="10 0 10 0" DockPanel.Dock="Top" BorderThickness="1" VerticalAlignment="Top"
                          SelectionChanged="Register_Map_DataGrid_SelectionChanged" >
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="30">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <RadioButton IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn ElementStyle="{StaticResource CellTextCentered}" Width="80" Binding="{Binding Address}" FontFamily="Arial" >
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DataContext.Register_Map_DataGrid_Address_Tile,RelativeSource={RelativeSource AncestorType=Window} }" FontFamily="Arial"   />
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridTextColumn ElementStyle="{StaticResource CellTextCentered}" MinWidth="250"  Binding="{Binding Rohms}" FontFamily="Arial" >
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DataContext.Register_Map_DataGrid_Address_Description,RelativeSource={RelativeSource AncestorType=Window} }" FontFamily="Arial"  />
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <TextBlock Grid.Row="1"  Visibility="{Binding NoCOMFound_Visibility}" Text="No COM connected" Foreground="#FF496180" FontSize="14" FontFamily="Arial" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            
            <DockPanel Grid.Row="2" >
                <Button x:Name="btnOK" Visibility="{Binding Normal_Visibility}" AutomationProperties.AutomationId="Match_Address_Ok" Style="{StaticResource ButtonRoundedBlue}" Grid.Row="1" FontFamily="Arial" Content="OK" Margin="3,3,20,3"  CommandParameter="{Binding}" 
                        Foreground="White" BorderBrush="#FF1C4EFF" BorderThickness="0" Width="90" DockPanel.Dock="Right"
                        HorizontalContentAlignment="Center" HorizontalAlignment="Right" Height="34" FontSize="16" Command="{StaticResource Login_Command1}" IsEnabled="False" Opacity="0.5"/>
                <Button x:Name="btnNoCOMOK" Visibility="{Binding NoCOMFound_Visibility}" AutomationProperties.AutomationId="Match_Address_Ok" Style="{StaticResource ButtonRoundedBlue}" Grid.Row="1" FontFamily="Arial" Content="OK" Margin="3,3,20,3"  CommandParameter="{Binding}" 
                        Foreground="White" BorderBrush="#FF1C4EFF" BorderThickness="0" Width="90" DockPanel.Dock="Right"
                        HorizontalContentAlignment="Center" HorizontalAlignment="Right" Height="34" FontSize="16" Click="btnNoCOMOK_Click"/>

                <Button x:Name="BackButton" AutomationProperties.AutomationId="Match_Address_Back" Style="{StaticResource ButtonRoundedWhite }" Grid.Row="1" FontFamily="Arial" Grid.Column="1" Content="Back" Margin="3"  Width="90" DockPanel.Dock="Right" HorizontalAlignment="Right" Height="34" FontSize="16" Foreground="#FF858585" Click="BackButton_Click"/>
            </DockPanel>
        </Grid>

    </Border>
</Window>
