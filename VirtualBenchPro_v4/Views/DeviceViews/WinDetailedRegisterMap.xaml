<Window x:Class="VirtualBenchPro_v4.Views.DeviceViews.WinDetailedRegisterMap"
        xmlns:j="http://schemas.microsoft.com/expression/2010/interactivity"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VirtualBenchPro_v4.Views.DeviceViews"
        mc:Ignorable="d"
        Height="600"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" Background="#00000000" AllowsTransparency="True" 
        HorizontalContentAlignment="Center" VerticalContentAlignment="Center" >

    <Border CornerRadius="5" Background="White"  >
        <Border.Effect>
            <DropShadowEffect Color="#FF0A3C7F" Direction="0" BlurRadius="10" ShadowDepth="0" />
        </Border.Effect>
        <Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" >
                    <Border BorderThickness="0,0,0,1" BorderBrush="#FFE9EDF2" />
                    <Label VerticalContentAlignment="Center" FontSize="16" Foreground="#FF0A3C7F" Panel.ZIndex="2" Padding="0,5,5,5" Margin="20,0,33,0" FontWeight="Bold" FontFamily="Arial" Content="Register Map"/>

                    <Button x:Name="Detailed_RegisterMap_Maximize_Button" BorderBrush="{x:Null}" Click="Maximize_Button_Click" Width="20" HorizontalAlignment="Right" Margin="0,6,30,6" Panel.ZIndex="2">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Grid>
                                                <Image VerticalAlignment="Stretch" Source="{Binding Maximize_Restore_Icon}" Width="10" Height="10" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button x:Name="Close_Button" BorderBrush="{x:Null}" Click="Close_Button_Click" Width="20" HorizontalAlignment="Right" Margin="0,6,8,6" Height="20" BorderThickness="0" Panel.ZIndex="2" >
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Grid Background="{TemplateBinding Background}">
                                                <Image VerticalAlignment="Stretch" Source="/VirtualBenchPro_v4;component/Images/close@3x.png" Width="8" Height="8" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Margin="5 0 5 5" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="45*"/>
                        <ColumnDefinition Width="55*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50*"/>
                        <RowDefinition Height="50*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Column="0" Grid.RowSpan="2" BorderThickness="0 0 1 0" BorderBrush="#FFE9EDF2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Search" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0 0 180 0" Foreground="#5A708C" FontFamily="Arial" FontSize="12" />
                            <Border x:Name="SearchTextBox_Border" Width="150" Height="23" Margin="0,0,20,0" CornerRadius="4" BorderBrush="LightGray" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBox x:Name="SearchTextBox" VerticalContentAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Width="150" Height="23" Background="Transparent" Padding="5 0" Foreground="#FF496180" FontSize="12"  
                                    KeyDown="SearchTextBox_KeyDown" BorderBrush="{x:Null}" BorderThickness="0" />
                            </Border>
                            <DataGrid x:Name="Register_Map_DataGrid" Grid.Row="1" Margin="5 0 5 5" BorderBrush="Transparent"  SelectionMode="Single" AlternationCount="2" Style="{DynamicResource DGHeaderStyle}" 
                                  AutoGenerateColumns="False" IsReadOnly="True" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CanUserAddRows="False" CanUserResizeColumns="False" 
                                  CanUserResizeRows="False" Background="Transparent"  EnableRowVirtualization="False" HeadersVisibility="Column" GridLinesVisibility="None"  CanUserReorderColumns="False" 
                                  SelectedItem="{Binding SelectedRegister}" ItemsSource="{Binding CurrentRegisterMap}" Sorting="Register_Map_DataGrid_Sorting">
                                <DataGrid.Columns>
                                    <DataGridTextColumn ElementStyle="{StaticResource CellTextVerticalCentered}" MinWidth="160" Width="*" Header="Register Name" Binding="{Binding Name}" FontFamily="Arial"  />
                                    <DataGridTextColumn ElementStyle="{StaticResource CellTextCentered}" MinWidth="55" Width="*" Header="Page" Binding="{Binding Page}" FontFamily="Arial" />
                                    <DataGridTextColumn ElementStyle="{StaticResource CellTextCentered}" MinWidth="60" Width="*" Header="Address" FontFamily="Arial">
                                        <DataGridTextColumn.Binding>
                                            <MultiBinding Converter="{StaticResource multidhc}">
                                                <Binding Path="Address" />
                                                <Binding Path="Address_H" />
                                            </MultiBinding>
                                        </DataGridTextColumn.Binding>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn ElementStyle="{StaticResource CellTextCentered}" MinWidth="55"  Width="*" Header="Type" Binding="{Binding DataType}" FontFamily="Arial"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource CellTextCentered}" MinWidth="55"  Width="*" Header="Right" Binding="{Binding Right}" FontFamily="Arial"/>
                                    <DataGridTextColumn ElementStyle="{StaticResource CellTextCentered}" MinWidth="60"  Width="*" Header="Value" Binding="{Binding Value, Converter={StaticResource dhc}}" FontFamily="Arial"/>
                                </DataGrid.Columns>
                            </DataGrid>

                        </Grid>
                    </Border>

                    <GridSplitter Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Width="2" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="Transparent" />

                    <Grid Grid.Column="1" Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding RegisterTitle}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10 0 0 0" Foreground="#FF0A3C7F" FontFamily="Arial" FontSize="14" FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 0 10 0">

                            <Button x:Name="Register_Read_Button" Panel.ZIndex="1" Width="65" Cursor="Hand" Height="23" Background="#00000000" BorderThickness="1" BorderBrush="#FFE9EDF2"
                                Visibility="{Binding SelectedRegister, Converter={StaticResource DetailRegMap_OperationEnableConverter}, ConverterParameter=Read}" Margin="0 0 10 0"
                                Command="{Binding ReadRegisterCommand}" >
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                                    <Canvas Width="14" Margin="0" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                    Data="M4.9 4.1L7 .5l2.1 3.6" Stroke="#FF0A3C7F">
                                        </Path>
                                        <Path xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StrokeStartLineCap="Round" StrokeEndLineCap="Round" 
                                    Data="M7 9.1V1.3M13.5 8.9v1.8a1.8 1.8 0 0 1-1.8 1.8H2.3a1.8 1.8 0 0 1-1.8-1.8V8.9" Stroke="#FF0A3C7F">
                                        </Path>
                                    </Canvas>
                                    <TextBlock Text="Read" VerticalAlignment="Center" Margin="5 2 0 0" Foreground="#FF0A3C7F" FontFamily="Arial" FontSize="10" FontWeight="Bold" />
                                </StackPanel>
                                <Button.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="4" />
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button x:Name="Register_Write_Button" Panel.ZIndex="1" Width="65" Cursor="Hand" Height="23" Background="#00000000" BorderThickness="1" BorderBrush="#FFE9EDF2"
                                Visibility="{Binding SelectedRegister, Converter={StaticResource DetailRegMap_OperationEnableConverter}, ConverterParameter=Write}"
                                Command="{Binding WriteRegisterCommand}" >
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                                    <Canvas Width="14" Margin="0" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" 
                                    Stroke="#FF0A3C7F" Data="M9.1 5.5L7 9.1 4.9 5.5">
                                        </Path>
                                        <Path xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  StrokeStartLineCap="Round" StrokeEndLineCap="Round" 
                                    Data="M7 .5v7.8M13.5 8.9v1.8a1.8 1.8 0 0 1-1.8 1.8H2.3a1.8 1.8 0 0 1-1.8-1.8V8.9" Stroke="#FF0A3C7F">
                                        </Path>
                                    </Canvas>
                                    <TextBlock Text="Write" VerticalAlignment="Center"  Margin="5 2 0 0" Foreground="#FF0A3C7F" FontFamily="Arial" FontSize="10" FontWeight="Bold"/>
                                </StackPanel>
                                <Button.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="4" />
                                    </Style>
                                </Button.Resources>
                            </Button>

                        </StackPanel>

                        <DataGrid x:Name="Bitcontrols_DataGrid" Grid.Row="1" Margin="5 0 5 5" BorderBrush="Transparent" AlternationCount="2" Style="{DynamicResource DGHeaderStyle}" 
                            AutoGenerateColumns="False" IsReadOnly="True" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CanUserAddRows="False" CanUserResizeColumns="True" 
                            CanUserResizeRows="False" Background="Transparent"  EnableRowVirtualization="False" HeadersVisibility="Column" GridLinesVisibility="All" CanUserReorderColumns="False" CanUserSortColumns="False"
                            ItemsSource="{Binding CurrentBitControlMap}" SelectedItem="{Binding SelectedBitControl}" CellStyle="{DynamicResource BitControlsDataGridCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn MinWidth="50" Width="SizeToCells" Header="Bits" FontFamily="Arial" >
                                    <DataGridTextColumn.Binding>
                                        <MultiBinding Converter="{StaticResource DetailRegMap_BitRangeConverter}">
                                            <Binding Path="Position" />
                                            <Binding Path="BitLength" />
                                        </MultiBinding>
                                    </DataGridTextColumn.Binding>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                            <Setter Property="TextBlock.Margin" Value="3" />
                                            <Setter Property="TextBlock.VerticalAlignment" Value="Center" />
                                            <Setter Property="TextBlock.HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Width="SizeToCells" MinWidth="100" Header="Bit Name" Binding="{Binding BitName}" FontFamily="Arial" >
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                            <Setter Property="TextBlock.Margin" Value="3" />
                                            <Setter Property="TextBlock.VerticalAlignment" Value="Center" />
                                            <Setter Property="TextBlock.HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Width="60" Header="Access" FontFamily="Arial" TextBlock.TextAlignment="Center" Binding="{Binding Access}" >
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                            <Setter Property="TextBlock.Margin" Value="3" />
                                            <Setter Property="TextBlock.VerticalAlignment" Value="Center" />
                                            <Setter Property="TextBlock.HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Width="70*" MinWidth="120" Header="Description" Binding="{Binding Description}" FontFamily="Arial" >
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                            <Setter Property="TextBlock.Margin" Value="3" />
                                            <Setter Property="TextBlock.HorizontalAlignment" Value="Stretch" />
                                            <Style.Triggers>
                                                <Trigger Property="TextBlock.Text" Value="-">
                                                    <Setter Property="TextBlock.HorizontalAlignment" Value="Center" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <!--<DataGridTextColumn Width="80" Header="Bit Value" FontFamily="Arial" >
                                <DataGridTextColumn.Binding>
                                    <MultiBinding Converter="{StaticResource DetailRegMap_BitValueConverter}">
                                        <Binding Path="DataContext.SelectedRegister" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=Window}" />
                                        <Binding Path="Position" />
                                        <Binding Path="BitLength" />
                                    </MultiBinding>
                                </DataGridTextColumn.Binding>
                                <DataGridTextColumn.ElementStyle>
                                    <Style>
                                        <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                        <Setter Property="TextBlock.Margin" Value="3" />
                                        <Setter Property="TextBlock.VerticalAlignment" Value="Center" />
                                        <Setter Property="TextBlock.HorizontalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>-->

                                <DataGridTemplateColumn MinWidth="150" Width="30*" Header="Bit Value" CellTemplateSelector="{StaticResource DetailRegMap_bitSelector}"/>

                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <GridSplitter Grid.Row="0" Grid.Column="1" Height="2" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Background="Transparent" />

                    <Grid Grid.Row="1" Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderThickness="0 1 0 1" BorderBrush="#FFE9EDF2">
                            <TextBlock Text="Description" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10 0 0 0" Foreground="#FF0A3C7F" FontFamily="Arial" FontSize="14" FontWeight="Bold" />
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{Binding SelectedRegister.Description}" Margin="10 5" FontSize="13" Grid.Row="1" Foreground="#FF496180" TextWrapping="WrapWithOverflow" FontFamily="Arial"/>
                                <Viewbox MaxHeight="300">
                                    <Image Source="{Binding Diagram}" Margin="5 0" Cursor="Hand" HorizontalAlignment="Center" Stretch="UniformToFill"/>
                                </Viewbox>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

            </Grid>

            <Rectangle x:Name="UI_Mask" Fill="LightGray" Panel.ZIndex="99" Opacity="0.5" Visibility="{Binding UIEnabled, Converter={StaticResource bgConverter}}" />

        </Grid>

    </Border>
</Window>
