<Window x:Class="VirtualBenchPro_v4.Views.DeviceViews.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VirtualBenchPro_v4.Views.DeviceViews"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="MainWindow" MinHeight="120" MinWidth="520" WindowStyle="None" Background="#00000000" WindowStartupLocation="CenterScreen" AllowsTransparency="True" SnapsToDevicePixels="True" 
        FontFamily="Arial" StateChanged="Window_StateChanged" LocationChanged="Window_LocationChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="3" />
    </WindowChrome.WindowChrome>
    <Border x:Name="WindowBorder" Margin="5" CornerRadius="5" Background="White">
        <Border.Effect>
            <DropShadowEffect Direction="0" BlurRadius="10" ShadowDepth="0" Opacity="0.35"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseDown="Grid_MouseDown">
                <Border BorderThickness="0,0,0,1" BorderBrush="#FFE9EDF2" />
                <Label x:Name="title_Label"  VerticalContentAlignment="Center" FontSize="16" Foreground="#FF0A3C7F" Panel.ZIndex="2" Padding="0,5,5,5" Margin="20,0,73,0" FontWeight="Bold" FontFamily="Arial" Content="Floating Window"/>

                <Button x:Name="Minimize_Button" BorderBrush="{x:Null}" Click="Minimize_Button_Click" Width="20" Height="20" HorizontalAlignment="Right" Margin="0,0,52,0" >
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Grid Background="{TemplateBinding Background}">
                                            <Image Source="/VirtualBenchPro_v4;component/Images/minimize@3x.png" Width="10" Height="10" />
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="Maximize_Button" BorderBrush="{x:Null}" Click="Maximize_Button_Click" Width="20" Height="20" HorizontalAlignment="Right" Margin="0,6,30,6" Panel.ZIndex="2" >
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Grid Background="{TemplateBinding Background}">
                                            <Image Source="{TemplateBinding Content}" Margin="5.2" VerticalAlignment="Stretch" />
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <!--<Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Grid>
                                            <Image VerticalAlignment="Stretch" Source="{Binding Maximize_Restore_Icon}" Width="10" Height="10" />
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>-->
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="Close_Button" BorderBrush="{x:Null}" Click="Close_Button_Click" Width="20" HorizontalAlignment="Right" Margin="0,6,8,6" Height="20" BorderThickness="0" Panel.ZIndex="2" >
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Grid Background="{TemplateBinding Background}">
                                            <Image VerticalAlignment="Stretch" Source="/VirtualBenchPro_v4;component/Images/close@3x.png" Width="8" Height="8" />
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
            <ContentControl x:Name="contentControl" Grid.Row="1"/>
        </Grid>
    </Border>

</Window>
