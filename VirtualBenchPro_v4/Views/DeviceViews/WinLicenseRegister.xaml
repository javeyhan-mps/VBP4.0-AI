<Window x:Class="VirtualBenchPro_v4.Views.DeviceViews.WinLicenseRegister"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:j="http://schemas.microsoft.com/expression/2010/interactivity"
        xmlns:local="clr-namespace:VirtualBenchPro_v4.Views.DeviceViews"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" Background="#00000000" AllowsTransparency="True" Width="450" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="320"  >
    <!--<Window.Resources>
        <ResourceDictionary>
            <RoutedCommand x:Key="Login_Command"/>
        </ResourceDictionary>
    </Window.Resources>
    <Window.CommandBindings>
        <CommandBinding Command="{StaticResource Login_Command}" CanExecute="Login_OnCanExecute" Executed="Login_Execute"/>
    </Window.CommandBindings>-->
    
    <Border Margin="5" CornerRadius="5" Background="White"  >
        <Border.Effect>
            <DropShadowEffect Color="#FFE9EDF2" Direction="0" BlurRadius="10" ShadowDepth="0" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" >
                <Border BorderThickness="0,0,0,1" BorderBrush="#FFE9EDF2" />
                <Label VerticalContentAlignment="Center" FontSize="14" Foreground="#FF0A3C7F" Panel.ZIndex="2" Padding="0,5,5,5" Margin="10,0,33,0" FontWeight="Bold" FontFamily="Arial" Content="Register Virtual Bench Pro 4"/>
                <Button x:Name="Close_Button" BorderBrush="{x:Null}" Click="Close_Button_Click" Width="20" HorizontalAlignment="Right" Margin="0,6,8,6" Height="20" BorderThickness="0" Panel.ZIndex="2" >
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Grid Background="{TemplateBinding Background}">
                                            <Image VerticalAlignment="Stretch" Source="/VirtualBenchPro_v4;component/Images/close@3x.png" Width="8" Height="8" />
                                            <!--<Image VerticalAlignment="Stretch"  Width="8" Height="8" />-->
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="0" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="70" />
                </Grid.RowDefinitions>
                <TextBlock Text="To Register Virtual Bench Pro, enter your license code or get one from your MPS contact." TextWrapping="WrapWithOverflow" Margin="10 10 10 0" FontFamily="Arial" Foreground="#657994" FontSize="13"/>
                <StackPanel Orientation="Vertical" Grid.Row="1" Margin="0 25 0 0">
                    <TextBlock Text="LICENSE CODE" HorizontalAlignment="Center" Foreground="#5A708C" FontFamily="Arial" FontSize="12" FontWeight="Bold"/>
                    <!--<ContentControl x:Name="code_tb" Template="{StaticResource WaterMarkTextBox}" Foreground="#FF0A3C7F" FontFamily="Arial" FontWeight="Bold" Height="25" Width="300" FontSize="12" Margin="0 3 0 0" Content="{Binding Code}"/>-->
                    <Border CornerRadius="5" Height="25" Width="300" BorderThickness="1" BorderBrush="LightGray" VerticalAlignment="Center" HorizontalAlignment="Center" >
                        <Grid>
                            <Label x:Name="watermark_tb" Width="300" Height="25" Foreground="#c1cad6" FontFamily="Arial" Content="0000-0000-0000-0000" FontSize="12" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" >
                                <Label.Visibility>
                                    <MultiBinding Converter="{StaticResource WaterMarkVisibleConverter}" ConverterParameter="license">
                                        <Binding ElementName="content_tb" Path="IsFocused" />
                                        <Binding ElementName="content_tb" Path="Text" />
                                    </MultiBinding>
                                </Label.Visibility>
                            </Label>
                            <TextBox x:Name="content_tb" Background="Transparent" VerticalAlignment="Center" VerticalContentAlignment="Center"  Height="25" Width="300" Panel.ZIndex="99" FontSize="12"
                         BorderBrush="{x:Null}" BorderThickness="0" FontFamily="Arial" Foreground="#FF0A3C7F" FontWeight="Bold" HorizontalAlignment="Center" HorizontalContentAlignment="Center"
                          TextChanged="content_tb_TextChanged"/>
                            <!--Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"-->
                        </Grid>
                    </Border>

                    <TextBlock Text="SECRET KEY" HorizontalAlignment="Center" Foreground="#5A708C" FontFamily="Arial" Margin="0 15 0 0" FontSize="12" FontWeight="Bold"/>
                    <!--<ContentControl x:Name="key_tb" Template="{StaticResource WaterMarkTextBox}" Foreground="#FF0A3C7F" FontFamily="Arial" FontWeight="Bold" Height="25" Width="300" FontSize="12" Margin="0 3 0 0" Content="{Binding Key}"/>-->
                    <Border CornerRadius="5" Height="25" Width="300" BorderThickness="1" BorderBrush="LightGray" VerticalAlignment="Center" HorizontalAlignment="Center" >
                        <Grid>
                            <Label x:Name="watermark1_tb" Width="300" Height="25" Foreground="#c1cad6" FontFamily="Arial" Content="0000-0000-0000-0000" FontSize="12" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" >
                                <Label.Visibility>
                                    <MultiBinding Converter="{StaticResource WaterMarkVisibleConverter}" ConverterParameter="license">
                                        <Binding ElementName="content1_tb" Path="IsFocused" />
                                        <Binding ElementName="content1_tb" Path="Text" />
                                    </MultiBinding>
                                </Label.Visibility>
                            </Label>
                            <TextBox x:Name="content1_tb" Background="Transparent" VerticalAlignment="Center" VerticalContentAlignment="Center"  Height="25" Width="300" Panel.ZIndex="99" FontSize="12"
                         BorderBrush="{x:Null}" BorderThickness="0" FontFamily="Arial" Foreground="#FF0A3C7F" FontWeight="Bold" HorizontalAlignment="Center" HorizontalContentAlignment="Center"
                         TextChanged="content_tb_TextChanged"/>
                            <!--Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"-->
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 6 0 0">
                        <TextBlock x:Name="default_tb" Text="Don't have a license yet? " FontFamily="Arial" Foreground="#657994" VerticalAlignment="Bottom" Height="15" Focusable="True" FocusVisualStyle="{x:Null}"/>
                        <Button x:Name="request_tb"  Foreground="#335fff" Content="Request a license."  FontFamily="Arial"  Height="15" 
                                VerticalContentAlignment="Bottom" VerticalAlignment="Bottom" Click="request_tb_Click">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border x:Name="MyBackgroundElement" BorderBrush="#335fff"  BorderThickness=" 0 0 0 1" Background="Transparent">
                                                    <ContentPresenter x:Name="ButtonContentPresenter" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="MyBackgroundElement" Property="Background" Value="Transparent"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Cursor" Value="Hand" />
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2">
                    <Button Style="{StaticResource ButtonRoundedWhite }" Grid.Row="1" FontFamily="Arial" Grid.Column="1" Content="Cancel" Margin="3" IsCancel="True" 
                            Width="100" DockPanel.Dock="Right" HorizontalAlignment="Right" Height="34" FontSize="16" Foreground="#FF858585" Click="Close_Button_Click"/>
                    <Button x:Name="Register_Button" Style="{StaticResource ButtonRoundedBlue}" Grid.Row="1" FontFamily="Arial" Grid.Column="2" Content="Register" Margin="10,3,20,3" 
                            Foreground="White" BorderBrush="#FF1C4EFF" BorderThickness="0" Width="110" DockPanel.Dock="Right" HorizontalContentAlignment="Center" HorizontalAlignment="Right" Height="34" 
                            FontSize="16" IsEnabled="False" Opacity="0.5" Click="Register_Button_Click">
                        <!--Command="{StaticResource Login_Command}" CommandParameter="{Binding}">-->
                        <!--<j:Interaction.Triggers >
                            <j:EventTrigger EventName="Click">
                                <j:InvokeCommandAction Command="{Binding RegisterCommand}" />
                            </j:EventTrigger>
                        </j:Interaction.Triggers>-->
                    </Button>
                </StackPanel>
            </Grid>

        </Grid>

    </Border>
</Window>
