<Window x:Class="VirtualBenchPro_v4.Views.DeviceViews.SetFriendlyNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VirtualBenchPro_v4.Views.DeviceViews"
        mc:Ignorable="d"
        x:Name="ThisWindow" Height="180" Width="450" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="#00000000" AllowsTransparency="True" ResizeMode="NoResize" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" >
    <Border Margin="25,25" CornerRadius="5" Background="White" Padding="0" >
        <Border.Effect>
            <DropShadowEffect Direction="0" BlurRadius="20" ShadowDepth="0" Opacity="0.35" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" MouseDown="Grid_MouseDown">
                <Border BorderThickness="0,0,0,1" BorderBrush="#FFE9EDF2" MouseDown="Grid_MouseDown"/>
                <Label VerticalContentAlignment="Center" FontSize="14" Foreground="#FF0A3C7F" Panel.ZIndex="2" Padding="0,5,5,5" Margin="16,0,33,0" FontFamily="Arial" Content="Enter friendly name" FontWeight="Bold"/>
                <Button x:Name="Close_Button" BorderBrush="{x:Null}" Click="Close_Button_Click" Width="20" HorizontalAlignment="Right" Margin="0,6,8,6" Height="20" BorderThickness="0" Panel.ZIndex="2" >
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Grid Background="{TemplateBinding Background}">
                                            <Image VerticalAlignment="Stretch" Source="/VirtualBenchPro_v4;component/Images/close@3x.png" Width="8" Height="8" />
                                            <!--<Image VerticalAlignment="Stretch"  Width="8" Height="8" />-->
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
            <ScrollViewer Grid.Row="1" Width="auto" Height="auto" VerticalScrollBarVisibility="Hidden">
                <Grid Margin="5,0,5,5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="46"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,5,0,5" HorizontalAlignment="Stretch">
                        <Grid Height="24" Margin="10,0,10,0" HorizontalAlignment="Stretch">
                            <TextBlock x:Name="watermark_tb" Padding="5,0,24,0" VerticalAlignment="Center" Background="Transparent" Foreground="Gray" 
                                       FontSize="12" FontFamily="Arial" Text="Friendly Name" >
                                <TextBlock.Visibility>
                                    <MultiBinding Converter="{StaticResource NonValidationTextBoxWaterMarkVisibilityConveter}">
                                        <Binding ElementName="FriendlyNameTextBox" Path="IsFocused" />
                                        <Binding ElementName="FriendlyNameTextBox" Path="Text" />
                                    </MultiBinding>
                                </TextBlock.Visibility>
                            </TextBlock>
                        </Grid>
                        <TextBox x:Name="FriendlyNameTextBox" Height="24" Margin="10,0,10,0" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" Padding="3,0,22,0" Foreground="#FF496180" FontSize="14" Text="{Binding FriendlyName, UpdateSourceTrigger=PropertyChanged}" 
                             Background="Transparent" MaxLength="10">
                            <TextBox.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </Grid>
                    <DockPanel Grid.Row="1" Grid.Column="0">
                        <Button Style="{StaticResource ButtonRoundedBlue}" Grid.Row="1" FontFamily="Arial" Grid.Column="2" Content="Set" Margin="3,3,10,3" 
                                Command="{Binding SetFriendlyNameComand}" CommandParameter="{Binding ElementName=ThisWindow}" Foreground="White" BorderBrush="#FF1C4EFF"
                                BorderThickness="0" Width="90" DockPanel.Dock="Right" HorizontalContentAlignment="Center" HorizontalAlignment="Right" Height="34" 
                                FontSize="16" />
                        <Button Style="{StaticResource ButtonRoundedWhite}" Grid.Row="1" FontFamily="Arial" Grid.Column="1" Content="Cancel" Margin="3" IsCancel="True" 
                                Width="105" DockPanel.Dock="Right" HorizontalAlignment="Right" Height="34" FontSize="16" Foreground="#FF858585"/>
                    </DockPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>

