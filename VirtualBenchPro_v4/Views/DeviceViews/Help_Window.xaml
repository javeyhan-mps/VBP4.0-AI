<Window x:Class="VirtualBenchPro_v4.Views.Help_Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VirtualBenchPro_v4.Views"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" Background="#00000000" AllowsTransparency="True" Width="405" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"  >
    <Border Margin="5" CornerRadius="5" Background="White" HorizontalAlignment="Center" MinHeight="405" VerticalAlignment="Center"  >
        <Border.Effect>
            <DropShadowEffect Color="#FFE9EDF2" Direction="0" BlurRadius="10" ShadowDepth="0" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseDown="Grid_MouseDown">
                <Border BorderThickness="0,0,0,1" BorderBrush="#FFE9EDF2" MouseDown="Grid_MouseDown"/>
                <Label x:Name="Help_Title_Label" VerticalContentAlignment="Center" FontSize="14" Foreground="#FF0A3C7F" Panel.ZIndex="2" Padding="0,5,5,5" Margin="16,0,33,0" FontWeight="Bold" FontFamily="Arial" TextOptions.TextFormattingMode="Display"/>
                <Button x:Name="Max_Button" BorderBrush="{x:Null}" Click="Max_Button_Click"  Width="20" HorizontalAlignment="Right" Margin="0,6,28,6" Height="20" BorderThickness="0" Panel.ZIndex="2" >
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Grid Background="{TemplateBinding Background}">
                                            <Image VerticalAlignment="Stretch" Source="/VirtualBenchPro_v4;component/Images/max@3x.png" Width="10" Height="10" />
                                            <!--<Image VerticalAlignment="Stretch"  Width="8" Height="8" />-->
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="Close_Button" BorderBrush="{x:Null}" Click="Close_Button_Click" Width="20" HorizontalAlignment="Right" Margin="0,6,8,6" Height="20" BorderThickness="0" Panel.ZIndex="2" >
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Grid Background="{TemplateBinding Background}">
                                            <Image VerticalAlignment="Stretch" Source="/VirtualBenchPro_v4;component/Images/close@3x.png" Width="8" Height="8" />
                                            <!--<Image VerticalAlignment="Stretch"  Width="8" Height="8" />-->
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,16">
                <Frame x:Name="Help_View" NavigationUIVisibility="Hidden" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

        </Grid>

    </Border>
</Window>
