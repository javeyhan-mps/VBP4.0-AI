<Window x:Class="VirtualBenchPro_v4.Views.DeviceViews.WinKitVersion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VirtualBenchPro_v4.Views.DeviceViews"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" Background="#00000000" AllowsTransparency="True" Width="450" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" SizeToContent="Height"><!--Height="235"-->
    <Border Margin="5" CornerRadius="5" Background="White"  >
        <Border.Effect>
            <DropShadowEffect Color="#FFE9EDF2" Direction="0" BlurRadius="10" ShadowDepth="0" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" >
                <Border BorderThickness="0,0,0,1" BorderBrush="#FFE9EDF2" />
                <Label VerticalContentAlignment="Center" FontSize="14" Foreground="#FF0A3C7F" Panel.ZIndex="2" Padding="0,5,5,5" Margin="16,0,33,0" FontWeight="Bold" FontFamily="Arial" Content="Kit Version"/>
            </Grid>

            <StackPanel Orientation="Vertical" Grid.Row="1" Margin="30 0">
                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15 20 0 0" FontFamily="Arial" FontSize="15" >
                    <Run Text="EVKT Type: " />
                    <Run x:Name="kit_type" />
                </TextBlock>
                <TextBlock x:Name="Kit_Version_Label" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15 20 0 0" FontFamily="Arial" FontSize="15" >
                    <Run Text="EVKT Version: " />
                    <Run x:Name="kit_version" />
                </TextBlock>
                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15 20 0 0" FontFamily="Arial" FontSize="15" >
                    <Run Text="EVKT Firmware: " />
                    <Run x:Name="fw_reversion" />
                </TextBlock>
                <Grid>
                    <StackPanel x:Name="update_msg" Orientation="Horizontal" Margin="0 10 0 0" Visibility="Collapsed" >
                        <Image Source="/VirtualBenchPro_v4;component/Images/info@3x.png" Height="13" Width="13" VerticalAlignment="Center" Margin="0 0 1 0" />
                        <TextBlock HorizontalAlignment="Left" FontFamily="Arial" FontSize="13" FontStyle="Italic" Foreground="#FF0A3C7F" VerticalAlignment="Bottom" Padding="0 0 0 1">
                        <Run Text="The firmware" />
                        <Run x:Name="new_fw_reversion" />
                        <Run Text="has released. " />
                        </TextBlock>
                        <Button x:Name="FW_Update_Button" Content="Click here" BorderBrush="#FF1C4EFF" Foreground="#FF1C4EFF" FontStyle="Italic" 
                            BorderThickness="0 0 0 1" Background="Transparent" FontFamily="Arial" FontSize="13" Padding="0 2 0 0" Cursor="Hand" FocusVisualStyle="{x:Null}"
                            Click="FW_Update_Button_Click"/>
                        <TextBlock Text=" to update the kit." FontFamily="Arial" FontSize="13" FontStyle="Italic" Foreground="#FF0A3C7F" VerticalAlignment="Bottom" Padding="0 0 0 1"/>
                    </StackPanel>
                    <StackPanel x:Name="latestfw_msg" Orientation="Horizontal" Margin="0 10 0 0" Visibility="Collapsed">
                        <Image Source="/VirtualBenchPro_v4;component/Images/done.png" Height="14" Width="14" VerticalAlignment="Center" Margin="0 0 1 0" />
                        <TextBlock HorizontalAlignment="Left" FontFamily="Arial" FontSize="13" FontStyle="Italic" Foreground="ForestGreen" VerticalAlignment="Bottom" Padding="0 0 0 1"
                           Text=" You are currently running the most recent version of kit."/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" x:Name="force_update_msg">
                        <StackPanel  Orientation="Horizontal" Margin="0 10 0 0"  >
                            <Image Source="/VirtualBenchPro_v4;component/Images/info@3x.png" Height="13" Width="13" VerticalAlignment="Center" Margin="2 0 1 0" />

                            <TextBlock HorizontalAlignment="Left" Text=" Force upgdate for " FontFamily="Arial" FontSize="13" FontStyle="Italic" Foreground="#FF0A3C7F" VerticalAlignment="Bottom" Padding="0 0 0 1" />
                            <Button x:Name="USBI2C_FW_Update_Button" Content="USBI2C" BorderBrush="#FF1C4EFF" Foreground="#FF1C4EFF" FontStyle="Italic" 
                        BorderThickness="0 0 0 1" Background="Transparent" FontFamily="Arial" FontSize="13" Padding="0 2 0 0" Cursor="Hand" FocusVisualStyle="{x:Null}"
                        Click="USBI2C_FW_Update_Button_Click"/>
                            <TextBlock Text=" or " FontFamily="Arial" FontSize="13" FontStyle="Italic" Foreground="#FF0A3C7F" VerticalAlignment="Bottom" Padding="0 0 0 1"/>
                            <Button x:Name="Automotive_FW_Update_Button" Content="AUTOMOTIVE" BorderBrush="#FF1C4EFF" Foreground="#FF1C4EFF" FontStyle="Italic" 
                                BorderThickness="0 0 0 1" Background="Transparent" FontFamily="Arial" FontSize="13" Padding="0 2 0 0" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                Click="Automotive_FW_Update_Button_Click"/>
                            <TextBlock Text=" dongle." FontFamily="Arial" FontSize="13" FontStyle="Italic" Foreground="#FF0A3C7F" VerticalAlignment="Bottom" Padding="0 0 0 1" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/VirtualBenchPro_v4;component/Images/red_alert.png" Height="17" Width="17" VerticalAlignment="Top" Margin="0 2 1 0" />

                            <TextBlock Text=" If your dongle is not USBI2C or AUTOMOTIVE type, the force update may cause dongle damage." TextWrapping="WrapWithOverflow" 
                                   FontFamily="Arial" FontSize="13" Width="360" FontStyle="Italic" Foreground="Red" VerticalAlignment="Bottom" Padding="0 0 0 1" Margin="0 5 1 0">
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
            
            <Button Grid.Row="2" Style="{StaticResource ButtonRoundedBlue}" FontFamily="Arial" Content="OK" Margin="0,0,20,0" 
                                Foreground="White" BorderBrush="#FF1C4EFF"
                                BorderThickness="0" Width="97" DockPanel.Dock="Right" HorizontalContentAlignment="Center" HorizontalAlignment="Right" Height="30" 
                                FontSize="16" VerticalAlignment="Center" IsCancel="True" />
        </Grid>

    </Border>
</Window>