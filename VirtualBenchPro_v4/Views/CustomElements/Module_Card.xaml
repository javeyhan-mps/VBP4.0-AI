<UserControl x:Class="VirtualBenchPro_v4.Views.CustomElements.Module_Card"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VirtualBenchPro_v4.Views.CustomElements"
             mc:Ignorable="d" 
             MinHeight="160" MaxWidth="500" SnapsToDevicePixels="True" ClipToBounds="True" Margin="5,0,0,5">
    <Border Margin="0" Background="White" BorderBrush="#FFE9EDF2" BorderThickness="2" CornerRadius="5" Padding="0" ClipToBounds="True" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="26" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="37" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.7*"/>
                    <ColumnDefinition Width="0.3*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="{Binding Module_Name}" VerticalAlignment="Top" Padding="0" VerticalContentAlignment="Center" Foreground="#FF496180" Margin="15,10,0,0" Background="{x:Null}" FontWeight="Bold" FontFamily="Arial" FontSize="11"/>
                <Grid x:Name="Top_Right_Section" Grid.Column="1">
                    <Label Content="Status" Foreground="#FF496180" FontFamily="Arial" FontSize="10" Margin="0,8,50,8" Background="{x:Null}" Padding="0" HorizontalAlignment="Right" Width="29"/>
                    <local:Status_LED x:Name="Status_LED_Icon" DockPanel.Dock="Right" Margin="0,8,35,8" Height="Auto" HorizontalAlignment="Right" />
                    <Label x:Name="Close_Icon" Content="" Padding="0" FontFamily="Arial" PreviewMouseLeftButtonUp="Close_Icon_PreviewMouseLeftButtonUp" Cursor="Hand" Panel.ZIndex="10" HorizontalAlignment="Right" Width="20" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="#FF9EACBF" Margin="0,3,3,3" Height="20">
                        <Label.OpacityMask>
                            <VisualBrush Stretch="None" Visual="{StaticResource Close_Icon}"/>
                        </Label.OpacityMask>
                    </Label>
                </Grid>
            </Grid>
            <Grid Grid.Row="1">
                <WrapPanel>
                    <StackPanel Orientation="Horizontal">
                        <Grid x:Name="Input_Table" Margin="14,14,0,0">

                        </Grid>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Grid x:Name="Channel_Table" Margin="14">

                        </Grid>
                    </StackPanel>
                </WrapPanel>
            </Grid>
            <Grid Grid.Row="2" >
                <Border Margin="0,0,0,35" Background="#FFE9EDF2" Height="1" />
                <Label Content="Temperature" HorizontalAlignment="Left" Margin="14,0,0,17" Padding="0" FontSize="10" FontFamily="Arial" VerticalContentAlignment="Center" Height="10" VerticalAlignment="Bottom" Foreground="#FF496180"/>
                <Label HorizontalAlignment="Left" Margin="86,0,0,17" Padding="0" FontSize="10" FontFamily="Arial" VerticalContentAlignment="Center" Height="10" VerticalAlignment="Bottom" Foreground="#FF95AAB9" Width="45">
                    <TextBlock>
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} ºC">
                                <Binding Path="Temperature" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Label>
            </Grid>
        </Grid>
    </Border>
</UserControl>
