<Window x:Class="VirtualBenchPro_v4.Views.CustomElements.CloseConfirmation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VirtualBenchPro_v4.Views.CustomElements"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" Background="#00000000" AllowsTransparency="True" Width="405" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="309"  >
    <Border Margin="5" CornerRadius="5" Background="White"  >
        <Border.Effect>
            <DropShadowEffect Color="#FFE9EDF2" Direction="0" BlurRadius="10" ShadowDepth="0" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseDown="Grid_MouseDown">
                <Border BorderThickness="0,0,0,1" BorderBrush="#FFE9EDF2" MouseDown="Grid_MouseDown"/>
                <Label VerticalContentAlignment="Center" FontSize="14" Foreground="#FF0A3C7F" Panel.ZIndex="2" Padding="0,5,5,5" Margin="16,0,33,0" FontWeight="Bold" FontFamily="Arial" Content="Close File"/>
                <Button x:Name="Close_Button" BorderBrush="{x:Null}" Click="Close_Button_Click" Width="20" HorizontalAlignment="Right" Margin="0,6,8,6" Height="20" BorderThickness="0" Panel.ZIndex="2" >
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Grid Background="{TemplateBinding Background}">
                                            <Image VerticalAlignment="Stretch" Source="/VirtualBenchPro_v4;component/Images/close@3x.png" Width="8" Height="8" />
                                            <!--<Image VerticalAlignment="Stretch"  Width="8" Height="8" />-->
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="0">

                <Button Style="{StaticResource ButtonRoundedBlue}" FontFamily="Arial" Content="Close" Margin="0,0,16,24" 
                            Foreground="White" BorderBrush="#FF1C4EFF"
                            BorderThickness="0" Width="97" DockPanel.Dock="Right" HorizontalContentAlignment="Center" HorizontalAlignment="Right" Height="34" 
                            FontSize="16" VerticalAlignment="Bottom" Click="Confirm_Button_Click" />
                <Button Style="{StaticResource ButtonRoundedWhite }" FontFamily="Arial" Content="Cancel" Margin="0,0,121,24" IsCancel="True" 
                            Width="105" DockPanel.Dock="Right" HorizontalAlignment="Right" Height="34" FontSize="16" Foreground="#FF858585" VerticalAlignment="Bottom"/>
                <TextBlock Margin="16,15,16,0" TextWrapping="Wrap" Text="You have unsaved changes in your project. Do you want to close anyway?" VerticalAlignment="Top" FontFamily="Arial" FontSize="14" Foreground="#FF496180"/>
            </Grid>

        </Grid>

    </Border>

</Window>
