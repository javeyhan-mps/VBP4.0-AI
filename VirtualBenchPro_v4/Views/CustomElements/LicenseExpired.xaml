<UserControl x:Class="VirtualBenchPro_v4.Views.CustomElements.LicenseExpired"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VirtualBenchPro_v4.Views.CustomElements"
             mc:Ignorable="d" 
             d:DesignHeight="20" d:DesignWidth="116">
    <Border x:Name="border" CornerRadius="3" Background="#b94358">
        <StackPanel Orientation="Horizontal">
            <Border CornerRadius="3 0 0 3" Background="White"  Height="18" Width="50" Margin="2 0 0 0">
                <TextBlock Text="License" FontFamily="Arial" VerticalAlignment="Center" HorizontalAlignment="Left" Background="Transparent"  Foreground="#b94358" Padding="3 1 0 0" />
            </Border>
            <TextBlock Text="EXPIRED" VerticalAlignment="Center" Margin="5 0 0 0" FontFamily="Arial" Foreground="White"/>
        </StackPanel>
    </Border>
</UserControl>
