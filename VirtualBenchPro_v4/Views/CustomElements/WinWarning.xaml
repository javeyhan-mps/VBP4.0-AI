<Window x:Class="VirtualBenchPro_v4.Views.CustomElements.WinWarning"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VirtualBenchPro_v4.Views"
        xmlns:Helper ="clr-namespace:VirtualBenchPro_v4.Helper"
        mc:Ignorable="d"
        Height="200" 
        Width="450" 
        WindowState="Normal" 
        WindowStyle="None" 
        WindowStartupLocation="CenterScreen"    
        Background="Transparent" Opacity="15" AllowsTransparency="True" ShowInTaskbar="False" Helper:WindowHelper.IsMainWindowOwner="True">
    <Border Margin="5" CornerRadius="5" Background="White"  >
        <Border.Effect>
            <DropShadowEffect Color="#FFE9EDF2" Direction="0" BlurRadius="10" ShadowDepth="0" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" >
                <Border BorderThickness="0,0,0,1" BorderBrush="#FFE9EDF2" />
                <Label VerticalContentAlignment="Center" FontSize="13" Foreground="#FF0A3C7F" Panel.ZIndex="2" Padding="0,5,5,5" Margin="10,0,0,0" FontWeight="Bold" FontFamily="Arial" Content="WARNING"/>
                <Button x:Name="Close_Button" BorderBrush="{x:Null}" Click="Close_Button_Click" Width="20" HorizontalAlignment="Right" Margin="0,6,8,6" Height="8" BorderThickness="0" Panel.ZIndex="2" >
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Grid Background="{TemplateBinding Background}">
                                            <Image VerticalAlignment="Stretch" Source="/VirtualBenchPro_v4;component/Images/close@3x.png" Width="6" Height="6" />
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <TextBlock x:Name="msg_tb" Grid.Row="1" FontSize="15" Foreground="#FF0A3C7F" FontFamily="Arial" TextWrapping="WrapWithOverflow" VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <Button Style="{StaticResource ButtonRoundedBlue}" Grid.Row="2" FontFamily="Arial" Grid.Column="2" Content="OK" VerticalAlignment="Center" Margin="0 0 20 0"
                            Foreground="White" BorderBrush="#FF1C4EFF" BorderThickness="0" Width="80" DockPanel.Dock="Right" HorizontalContentAlignment="Center" HorizontalAlignment="Right" Height="34" 
                            FontSize="16" Click="OK_Button_Click" />
        </Grid>
    </Border>
</Window>
