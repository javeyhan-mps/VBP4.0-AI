<UserControl x:Class="VirtualBenchPro_v4.MenuButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VirtualBenchPro_v4.Views.CustomElements"
             mc:Ignorable="d" 
             Height="80" Width="100">
    <Grid>
        <Button VerticalAlignment="Top" Height="80" Background="White" BorderBrush="{x:Null}" >
            <Button.Content>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="{Binding Icon}" Panel.ZIndex="1" Width="32" Margin="0,0,0,6" />
                    <Label Content="{Binding Content}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="14" Padding="0" Foreground="#FF818181" FontFamily="ArialMT"/>
                </StackPanel>
            </Button.Content>
        </Button>
    </Grid>
</UserControl>
