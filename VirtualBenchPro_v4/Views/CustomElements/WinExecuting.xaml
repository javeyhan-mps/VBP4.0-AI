<Window x:Class="VirtualBenchPro_v4.Views.CustomElements.WinExecuting"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VirtualBenchPro_v4.Views.CustomElements"
        xmlns:view="clr-namespace:VirtualBenchPro_v4.Views.CustomElements"
        mc:Ignorable="d"
        Height="110" 
        Width="150" 
        WindowState="Normal" 
        WindowStyle="None" 
        WindowStartupLocation="CenterScreen"    
        Background="Transparent" Opacity="15" AllowsTransparency="True" ShowInTaskbar="False" Topmost="True">

    <Border Margin="5" CornerRadius="5" Background="White"  >
        <Border.Effect>
            <DropShadowEffect Color="#FFE9EDF2" Direction="0" BlurRadius="10" ShadowDepth="0" />
        </Border.Effect>
        <StackPanel>
            <view:SquareProgressBar Grid.Column="0" HorizontalAlignment="Center" Margin="0 10"/>
            <Label x:Name="xlabel" FontFamily="Arial" FontSize="13" HorizontalAlignment="Center" Foreground="#657994" />
        </StackPanel>
    </Border>

</Window>
