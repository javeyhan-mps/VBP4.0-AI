<UserControl x:Class="VirtualBenchPro_v4.Module_Button"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VirtualBenchPro_v4.Views.CustomElements"
             mc:Ignorable="d" 
             Height="24" Margin="0,0,5,0" >
    <Grid Cursor="Hand">
        <Border x:Name="Button_Border" Background="White" CornerRadius="5" BorderThickness="1" BorderBrush="#FFC9D5E4">
            <DockPanel x:Name="Button_Content" >
                <TextBlock x:Name="Module_Name" DockPanel.Dock="Left" TextWrapping="Wrap"  FontFamily="Arial" VerticalAlignment="Center" Margin="5,0"/>
                <Label x:Name="Close_Icon" Content="" DockPanel.Dock="Right" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="5,0" FontFamily="Arial" Margin="0" PreviewMouseLeftButtonUp="Label_PreviewMouseLeftButtonUp" Cursor="Hand" MouseEnter="Close_Icon_MouseEnter" MouseLeave="Close_Icon_MouseLeave" Panel.ZIndex="10" Background="#FF9EACBF" Width="20">
                    <Label.OpacityMask>
                        <VisualBrush Stretch="None" Visual="{StaticResource Close_Icon}"/>
                    </Label.OpacityMask>
                </Label>
                <local:Status_LED x:Name="Status_LED_Icon" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,5,0" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
