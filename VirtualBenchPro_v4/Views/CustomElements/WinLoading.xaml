<Window x:Class="VirtualBenchPro_v4.Views.CustomElements.WinLoading"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:view="clr-namespace:VirtualBenchPro_v4.Views.CustomElements"
        xmlns:local="clr-namespace:VirtualBenchPro_v4"
        mc:Ignorable="d"
       Title="WinLoading"
        Height="70" 
        Width="301" 
        WindowState="Normal" 
        WindowStyle="None" 
        WindowStartupLocation="CenterScreen" 
        Topmost="True"
        Background="Transparent" Opacity="15" AllowsTransparency="True" ShowInTaskbar="False">
    <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrush}}">
        <Grid >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Image Grid.RowSpan="2" Grid.ColumnSpan="2" Source="../../Images/Loading.png" Stretch="Fill"/>
            <!--<Border Grid.RowSpan="2" Grid.ColumnSpan="2" Background="AntiqueWhite" CornerRadius="10"/>-->
            <view:CircularProgressBar Grid.Column="0" Margin="20,10,10,10"/>

            <StackPanel VerticalAlignment="Center" Grid.Column="1" Margin="10,0">
                <TextBlock  Name="TextBorder" FontSize="10" Text="Scanning..." VerticalAlignment="Center" FontWeight="Bold" FontStyle="Italic" HorizontalAlignment="Left"/>
                <Rectangle Name="ReflectedText" Height="{Binding ElementName=TextBorder,Path=ActualHeight}"        
                           Width="{Binding ElementName=TextBorder,Path=ActualWidth}" 
                           HorizontalAlignment="Left"        
                           VerticalAlignment="Top">
                    <Rectangle.RenderTransform>
                        <TransformGroup>
                            <SkewTransform AngleX="38"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Rectangle.RenderTransform>
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <LinearGradientBrush.GradientStops>
                                <GradientStop Offset="0.0" Color="#66000000"></GradientStop>
                                <GradientStop Offset="1.0" Color="#00000000"></GradientStop>
                            </LinearGradientBrush.GradientStops>
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                    <Rectangle.Fill>
                        <VisualBrush Visual="{Binding ElementName=TextBorder}">
                            <VisualBrush.RelativeTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1" ScaleY="-1"></ScaleTransform>
                                    <TranslateTransform Y="1"></TranslateTransform>
                                </TransformGroup>
                            </VisualBrush.RelativeTransform>
                        </VisualBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </StackPanel>

        </Grid>
    </Border>
</Window>
