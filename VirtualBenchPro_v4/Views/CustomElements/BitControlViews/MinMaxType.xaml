<UserControl x:Class="VirtualBenchPro_v4.Views.CustomElements.MinMaxType"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VirtualBenchPro_v4.Views.CustomElements"
             mc:Ignorable="d" >
    <Grid Margin="0,5,0,0" Width="270">
        <DockPanel Margin="0">
            <TextBlock Text="{Binding BitName}" DockPanel.Dock="Left" HorizontalAlignment="Left" FontFamily="Arial" FontSize="10" Padding="0" TextWrapping="Wrap" Foreground="#FF496180" Margin="10,3,5,3" MaxWidth="100" VerticalAlignment="Center"/>
            <Label Content="{Binding Unit }" DockPanel.Dock="Left" HorizontalAlignment="Left" FontFamily="Arial" FontSize="10" Padding="0" VerticalContentAlignment="Center" Foreground="#FF496180" Margin="0,0,5,0"/>
            <Grid DockPanel.Dock="Right" >
                <Border BorderBrush="#FFE1E7EF" BorderThickness="1" CornerRadius="2" Margin="0,0,23,0" HorizontalAlignment="Right" Height="20" Width="102">
                    <TextBox x:Name="MinMaxType_TextBox" HorizontalAlignment="Right" Text="{Binding Value}" TextWrapping="Wrap" Width="100" BorderBrush="{x:Null}" FontFamily="Arial" VerticalContentAlignment="Center" PreviewTextInput="TextBox_PreviewTextInput" BorderThickness="0" Background="{x:Null}" HorizontalContentAlignment="Center" Foreground="#FF496180" Height="18" />
                </Border>

                <Grid x:Name="Help_Icon_Control" DockPanel.Dock="Left" HorizontalAlignment="Right"  Width="12" Height="12" Margin="0,4,5,4" />
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
