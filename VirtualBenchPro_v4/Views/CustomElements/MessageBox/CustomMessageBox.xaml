<Window x:Class="VirtualBenchPro_v4.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VirtualBenchPro_v4.Views.CustomElements"
        mc:Ignorable="d"
        SizeToContent="Height" Width="421" ResizeMode="NoResize" WindowStyle="None" Background="{x:Null}" AllowsTransparency="True" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen" MinHeight="100">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" />
    </WindowChrome.WindowChrome>
    <Grid ClipToBounds="True" >
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.RowSpan="2" BorderBrush="#FF1C4EFF" BorderThickness="2" CornerRadius="5"/>
        <Label Resources="{StaticResource TopRounded}" Grid.Row="0" Content="Virtual Bench Pro 4.0" MouseDown="Grid_MouseDown" Padding="0,1,0,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="#FF1C4EFF" Foreground="White" BorderThickness="0,0,0,1" UseLayoutRounding="False" FontFamily="Arial" FontSize="10" Margin="0,0,0,0" BorderBrush="#FF1C4EFF" />

        <Frame x:Name="MessageBoxContent"  Grid.Row="1" NavigationUIVisibility="Hidden"/>
    </Grid>


</Window>
