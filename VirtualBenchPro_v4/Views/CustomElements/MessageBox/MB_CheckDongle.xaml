<Page x:Class="VirtualBenchPro_v4.MB_CheckDongle"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      MinHeight="98" Width="417"
      Title="MB_CheckDongle">

    <Grid Background="White" Margin="0,0,0,2">
        <Image HorizontalAlignment="Left" Height="30" Margin="15,10,0,0" VerticalAlignment="Top" Width="30" Source="/VirtualBenchPro_v4;component/Images/Temporal_Icon_2.PNG"/>
        <TextBlock Text="Please check dongle and device connection or make sure that device is on" Margin="55,10,15,0" VerticalAlignment="Top" Height="30"  FontFamily="Arial" TextWrapping="WrapWithOverflow" FontWeight="Bold" />
        <Button Style="{StaticResource MessageButtonRounded}" Content="OK" Width="81" Margin="0,0,12,14" FontFamily="Arial" FontSize="10" Foreground="#FF6D7278" Padding="1" BorderBrush="#FF979797" Background="#FFD8D8D8" Click="Button_Click" Height="22" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
    </Grid>
</Page>
