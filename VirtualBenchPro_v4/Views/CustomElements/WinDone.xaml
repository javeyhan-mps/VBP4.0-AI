<Window x:Class="VirtualBenchPro_v4.Views.CustomElements.WinDone"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VirtualBenchPro_v4.Views.CustomElements"
        xmlns:Helper ="clr-namespace:VirtualBenchPro_v4.Helper"
        mc:Ignorable="d"
        Height="90" 
        Width="130" 
        WindowState="Normal" 
        WindowStyle="None" 
        WindowStartupLocation="CenterScreen"    
        Background="Transparent" Opacity="15" AllowsTransparency="True" ShowInTaskbar="False" Helper:WindowHelper.IsMainWindowOwner="True">

    <Border Margin="5" CornerRadius="5" Background="White"  >
        <Border.Effect>
            <DropShadowEffect Color="#FFE9EDF2" Direction="0" BlurRadius="10" ShadowDepth="0" />
        </Border.Effect>
        <StackPanel>
            <Image Source="../../Images/done.png" Height="40" Width="40" Margin="0 10 0 0"/>
            <Label x:Name="xlabel" Content="Done!" FontFamily="Arial" FontSize="12" HorizontalAlignment="Center" Foreground="#767a7d" />
        </StackPanel>
    </Border>

</Window>
