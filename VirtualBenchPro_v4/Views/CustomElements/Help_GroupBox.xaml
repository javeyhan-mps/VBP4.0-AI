<UserControl x:Class="VirtualBenchPro_v4.Views.CustomElements.Help_GroupBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VirtualBenchPro_v4.Views.CustomElements"
             mc:Ignorable="d" 
             Width="373" Margin="16,5,16,0" Background="#FFF0F0F0">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition MaxHeight="20"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <Label x:Name="SubGroup_Name" Content="" Grid.Row="0" Padding="9,0,5,0" Foreground="#FF496180" Height="20" HorizontalAlignment="Left"/>
        <WrapPanel x:Name="Content" Grid.Row="1" Orientation="Vertical"/>
    </Grid>
</UserControl>
