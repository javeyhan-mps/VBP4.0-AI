<UserControl x:Class="VirtualBenchPro_v4.Views.CustomElements.SquareProgressBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VirtualBenchPro_v4.Views.CustomElements"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="50">
    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="EllipseStyle" TargetType="Rectangle">
                <Setter Property="Width" Value="10"/>
                <Setter Property="Height" Value="25"/>
                <Setter Property="RadiusX" Value="5" />
                <Setter Property="RadiusY" Value="4" />
                <Setter Property="Stretch" Value="Fill"/>
                <Setter Property="Fill" Value="#FF1C4EFF"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="LayoutRoot" Background="Transparent" 
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.RenderTransform>
            <ScaleTransform ScaleX="0.4" ScaleY="0.4" />
        </Grid.RenderTransform>
        <Canvas RenderTransformOrigin="0.4,0.4" Width="50" Height="50" 
                HorizontalAlignment="Center" VerticalAlignment="Center" >
            <Rectangle  Style="{StaticResource EllipseStyle}" Opacity="1.0" 
                      Canvas.Left="55"  Canvas.Top="10" />
            <Rectangle Style="{StaticResource EllipseStyle}" Opacity="0.8" 
                     Canvas.Left="45" Canvas.Top="40"  >
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="135" CenterX="0" CenterY="0" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle Style="{StaticResource EllipseStyle}" Opacity="0.7" 
                     Canvas.Left="10" Canvas.Top="64"  >
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="270" CenterX="0" CenterY="0" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle  Style="{StaticResource EllipseStyle}" Opacity="0.5" 
                      Canvas.Left="40"  Canvas.Top="73" >
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="45" CenterX="0" CenterY="0" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle Style="{StaticResource EllipseStyle}" Opacity="0.4" 
                     Canvas.Left="55" Canvas.Top="80"  >
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="0" CenterX="0" CenterY="0" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle Style="{StaticResource EllipseStyle}" Opacity="0.3" 
                     Canvas.Left="100" Canvas.Top="91"  >
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="135" CenterX="0" CenterY="0" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle Style="{StaticResource EllipseStyle}" Opacity="0.2" 
                     Canvas.Left="110" Canvas.Top="55"  >
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="90" CenterX="0" CenterY="0" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Canvas.RenderTransform>
                <RotateTransform x:Name="SpinnerRotate" Angle="0" CenterX="42" CenterY="38"/>
            </Canvas.RenderTransform>
            <Canvas.Triggers>
                <EventTrigger RoutedEvent="ContentControl.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation 
                                    Storyboard.TargetName  ="SpinnerRotate"  
                                    Storyboard.TargetProperty ="(RotateTransform.Angle)" 
                                     From="0" To="360"  Duration="0:0:02" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Canvas.Triggers>
        </Canvas>
    </Grid>
</UserControl>



