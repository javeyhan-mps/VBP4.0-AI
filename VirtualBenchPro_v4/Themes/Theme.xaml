                                            <MultiBinding Converter="{StaticResource IsAdvanveNoteVisibleConverter}">
                                                <Binding Path="DataContext.AdvancedSetting" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=Page}"/>
                                                <Binding Path="DataContext.CategorySelectedId" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=Page}"/>
