            <Image ToolTipService.ShowDuration="60000" Margin="5 0 0 0" Width="13" Height="13"  Source="/VirtualBenchPro_v4;component/Images/info@3x.png" Visibility="{Binding Tip,Converter={StaticResource helpInfoImgConverter}}">
                <Image.ToolTip>
                    <ToolTip BorderBrush="Transparent" Background="Transparent">
                        <Border CornerRadius="5" Background="#0c98ff">
