                                                            <Binding Path="PageName" />
                                                            <Binding Path="DataContext.CurrentChip.Monitor.InFault" RelativeSource ="{RelativeSource Mode=FindAncestor, AncestorType=Page}" />
                                                            <Binding Path="DataContext.CurrentChip.Monitor.ch0Fault" RelativeSource ="{RelativeSource Mode=FindAncestor, AncestorType=Page}" />
                                                            <Binding Path="DataContext.CurrentChip.Monitor.ch1Fault" RelativeSource ="{RelativeSource Mode=FindAncestor, AncestorType=Page}" />
                                                            <Binding Path="DataContext.CurrentChip.Monitor.ch2Fault" RelativeSource ="{RelativeSource Mode=FindAncestor, AncestorType=Page}" />
                                                            <Binding Path="DataContext.CurrentChip.Monitor.ch3Fault" RelativeSource ="{RelativeSource Mode=FindAncestor, AncestorType=Page}" />
                                                            <Binding Path="DataContext.CurrentChip.Monitor.ch4Fault" RelativeSource ="{RelativeSource Mode=FindAncestor, AncestorType=Page}" />
                                                            <Binding Path="DataContext.CurrentChip.Monitor.ch5Fault" RelativeSource ="{RelativeSource Mode=FindAncestor, AncestorType=Page}" />
                                                            <Binding Path="DataContext.CurrentChip.Monitor.ch6Fault" RelativeSource ="{RelativeSource Mode=FindAncestor, AncestorType=Page}" />
