                         ItemsSource="{Binding DataContext.CurrentConfigMode.Pages, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}}" Height="30" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="15,0">
                    <ListBox.ItemsPanel>
