                                <ToggleButton.Style>
                                    <Style TargetType="{x:Type ToggleButton}">
                                        <Setter Property="MinWidth" Value="0"/>
                                        <Setter Property="MinHeight" Value="0"/>
                                        <Setter Property="Width" Value="Auto"/>
                                        <Setter Property="Height" Value="Auto"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="#FFE1E7EF"/>
                                        <Setter Property="Foreground" Value="#FF0A3C7F"/>

                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                    <DockPanel Background="{TemplateBinding Background}" LastChildFill="False" SnapsToDevicePixels="True">
                                                        <Border x:Name="Border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,0,0,0"  DockPanel.Dock="Right" Width="16">
                                                            <Path Data="M0,0L3.5,4 7,0z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </DockPanel>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">

                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                                <!--<ToggleButton.ToolTip>
                                    <ToolTip>
                                        <TextBlock >
                                            <TextBlock.Text>
                                                <MultiBinding  StringFormat="{}{0}   {1}   [{2}:{3}]"   >
                                                    <Binding Path="RegionName" />
                                                    <Binding Path="RegionAddress" Converter="{StaticResource Tooltip_AddressConverter}" />
                                                    <Binding Path="Position"/>
                                                    <Binding Path="BitLength" Converter="{StaticResource Tooltip_PositionConverter}" />
                                                </MultiBinding>

                                            </TextBlock.Text>
                                        </TextBlock>
                                    </ToolTip>
