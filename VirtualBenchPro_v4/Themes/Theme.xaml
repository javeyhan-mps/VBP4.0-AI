            <TextBox x:Name="txtValue" Grid.Column="0" FontSize="11" FontWeight="Normal" FontFamily="Arial" Height="20" Padding="14 0 3 0" Margin="0 0 0 0" 
                       BorderBrush="{x:Null}" BorderThickness="0" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" Background="Transparent"
                       IsReadOnly="true" Validation.ErrorTemplate="{x:Null}" FocusVisualStyle="{x:Null}" Focusable="False" Foreground="#FF0A3C7F">
                <TextBox.Text>
