    <DataTemplate x:Key="DetailRegMap_ReservedBitTextBoxTemplate">
        <Grid Margin="5 0">
            <TextBlock Grid.Column="0" Text="0b" Width="16" FontSize="11" FontWeight="Normal" FontFamily="Arial" HorizontalAlignment="Left" VerticalAlignment="Center" 
                       Padding="4 0 0 0" Panel.ZIndex="99"  Foreground="#FF0A3C7F" />

            <TextBox x:Name="txtValue" Grid.Column="0" FontSize="11" FontWeight="Normal" FontFamily="Arial" Height="20" Padding="14 0 3 0" Margin="0 0 0 0" 
                       BorderBrush="{x:Null}" BorderThickness="0" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" Background="Transparent"
                       IsReadOnly="true" Validation.ErrorTemplate="{x:Null}" FocusVisualStyle="{x:Null}" Focusable="False" Foreground="#FF0A3C7F">
                <TextBox.Text>
                    <Binding Path="CurrentRawBitValue" UpdateSourceTrigger="PropertyChanged" Mode="OneWay" />
                </TextBox.Text>
