                    <RowDefinition Height="*" />
                    <RowDefinition Height="2" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <!--Parameters-->
                <!--<GroupBox HorizontalAlignment="Stretch" MinHeight="50" VerticalAlignment="Top" BorderBrush="Transparent" Foreground="#FF0A3C7F" Visibility="{Binding Parameters, Converter={StaticResource RegionParamsVisibleConverter}}">-->
                <GroupBox HorizontalAlignment="Stretch"  VerticalAlignment="Top" BorderBrush="Transparent" Foreground="#FF0A3C7F" >
                    <GroupBox.Style>
                        <Style TargetType="{x:Type GroupBox}">
                            <Setter Property="Template">
