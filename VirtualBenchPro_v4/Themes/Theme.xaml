    <DataTemplate x:Key="DetailRegMap_BitReservedTemplate">
        <Grid Margin="3 0" >
            <Label Content="{Binding CurrentRawBitValue}" Margin="10 0 0 0" FontFamily="Arial" FontSize="11" Foreground="#FF0A3C7F" 
                   IsHitTestVisible="False" Focusable="False"
                   VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Center" HorizontalContentAlignment="Center"/>
        </Grid>
    </DataTemplate>

    <Style x:Key="BitControlsDataGridCellStyle" TargetType="{x:Type DataGridCell}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="Arial" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="BorderBrush" Value="#FFE9EDF2"/>
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="#FF496180" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,3,0,0"/>
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
