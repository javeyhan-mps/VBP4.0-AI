    <DataTemplate x:Key="OverviewTemplate">
        <ScrollViewer VerticalScrollBarVisibility="Auto" >
            <Grid x:Name="overview_tab" Margin="0 5 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="65*"/>
                </Grid.RowDefinitions>
                <!--<Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50*"/>
                    <ColumnDefinition Width="50*"/>
                </Grid.ColumnDefinitions>-->
                <StackPanel Orientation="Vertical" Grid.ColumnSpan="2" Margin="5 10 10 5" MinHeight="100">
                    <Label Content="{Binding DataContext.DescriptionTitle, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}}" Foreground="#154585" FontSize="14" Height="30" FontWeight="Bold" FontFamily="Arial"/>
                    <TextBlock TextWrapping="Wrap" Text="{Binding DataContext.Description, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}}" Foreground="#FF153C7E" FontSize="13" Margin="5 0 0 0" LineHeight="22" FontWeight="Normal" FontFamily="Arial"/>
                </StackPanel>

                <DockPanel Grid.Row="1">
                    <StackPanel Orientation="Vertical" Margin="5" DockPanel.Dock="Left" MaxWidth="{Binding DataContext.Diagram, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}, Converter={StaticResource OverViewFeaturesMinWidthConverter}}"><!--MaxWidth="350"-->
                        <Label Content="{Binding DataContext.FeaturesTitle, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}}" Foreground="#154585" FontSize="14" Height="30" FontWeight="Bold" FontFamily="Arial"/>
                        <TextBlock TextWrapping="Wrap" Text="{Binding DataContext.Features, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}}" Foreground="#FF153C7E" FontSize="13" Margin="5 0" LineHeight="25" FontWeight="Normal" FontFamily="Arial" />
                    </StackPanel>
                    <StackPanel Orientation="Vertical" DockPanel.Dock="Left" Margin="5 5 10 5" >
                        <Label Content="{Binding DataContext.DiagramTitle, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}}" Foreground="#154585" FontSize="14" Height="30" FontWeight="Bold" FontFamily="Arial"/>
                        <Image Source="{Binding DataContext.Diagram, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}}" Margin="5 0"  Cursor="Hand">
                            <!--MouseLeftButtonUp="Image_MouseLeftButtonUp"-->
                            <Image.ToolTip>
                                <ToolTip BorderBrush="Transparent" Background="Transparent">
                                    <Border CornerRadius="5" Background="#FF0C98FF">
                                        <TextBlock TextWrapping="Wrap" FontFamily="Arial" Foreground="White" Margin="5" Background="Transparent" Text="Click To Enlarge (Pop-Up)" MaxWidth="300"/>
                                    </Border>
                                </ToolTip>
                            </Image.ToolTip>
                            <j:Interaction.Triggers>
                                <j:EventTrigger EventName="MouseLeftButtonUp">
                                    <j:InvokeCommandAction Command="{Binding DataContext.DiagramEnlargeCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}}" CommandParameter="{Binding DataContext.Diagram, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}}" />
                                </j:EventTrigger>
                            </j:Interaction.Triggers>
                        </Image>
                    </StackPanel>
                </DockPanel>
            </Grid>

        </ScrollViewer>
    </DataTemplate>


    <Style x:Key="ToggleButtonStyle1" TargetType="{x:Type CheckBox}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <!--<Setter Property="IsChecked" Value="{TemplateBinding IsChecked}"/>-->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Off" Foreground="#FF496180" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 0 5 0"></TextBlock>
                        <Border CornerRadius="9" Background="White" Width="60" Height="20" BorderBrush="#e1e7ef" BorderThickness="1">
                            <Border x:Name="path1" Background="#e1e7ef" CornerRadius="7" Width="30" Height="15" Margin="2 0 0 0" HorizontalAlignment="Left" />
                        </Border>
                        <TextBlock Text="On" Foreground="#FF496180" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5 0 0 0"></TextBlock>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="path1" Property="Margin" Value="27,0,0,0"/>
                            <Setter TargetName="path1" Property="Background" Value="LightGreen" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="path1" Property="Margin" Value="2 0 0 0"/>
                            <Setter TargetName="path1" Property="Background" Value="#e1e7ef" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <DataTemplate x:Key="BitToggleTemplate">
        <Grid Margin="0,10,0,0" Visibility="{Binding Disabled, Converter={StaticResource bitVisibleConverter}}" Width="{c:Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType={x:Type GroupBox}}, Path=ActualWidth*0.93}" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40*"/>
                <ColumnDefinition Width="60*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Margin="0 0 2 0" Grid.Column="0" Text="{Binding ParamName}" ToolTip="{Binding  Converter={StaticResource BitToolTip_Converter}}"  HorizontalAlignment="Left" FontFamily="Arial" VerticalAlignment="Center" FontSize="12" FontWeight="Normal"  TextWrapping="Wrap" Foreground="#FF496180"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="1">
                <CheckBox Style="{StaticResource ToggleButtonStyle1}" Grid.Column="1" Margin="5" VerticalAlignment="Center" HorizontalAlignment="Right" IsEnabled="{Binding isEnable}"
                    IsChecked="{Binding isToggleOn, Mode=TwoWay}"  >
                    <j:Interaction.Triggers>
                        <j:EventTrigger EventName="Click">
                            <j:InvokeCommandAction Command="{Binding DataContext.UtilityCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}}" CommandParameter="{Binding }" />
                        </j:EventTrigger>
                    </j:Interaction.Triggers>
                </CheckBox>


                <Image ToolTipService.ShowDuration="60000" Grid.Column="2"  Margin="5 0 0 0" Width="12" Height="12"  Source="/VirtualBenchPro_v4;component/Images/info@3x.png"  Visibility="{Binding HelpInfo,Converter={StaticResource helpInfoImgConverter}}" >
                    <Image.ToolTip>
                        <ToolTip BorderBrush="Transparent" Background="Transparent">
                            <Border CornerRadius="5" Background="#0c98ff">
                                <StackPanel Orientation="Vertical" Margin="5">
                                    <TextBlock TextWrapping="Wrap" FontFamily="Arial" Foreground="White" Text="{Binding HelpInfo, Converter={StaticResource stringInfoConverter}, ConverterParameter=Tip}" MaxWidth="300" Background="Transparent" />
                                    <Image Source="{Binding HelpInfo, Converter={StaticResource stringInfoConverter}, ConverterParameter=Image}" Margin="5 0"/>
                                </StackPanel>
                            </Border>
                        </ToolTip>
                    </Image.ToolTip>
                </Image>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="BitButtonTemplate">
        <Grid Margin="0,10,0,0"  Visibility="{Binding Disabled, Converter={StaticResource bitVisibleConverter}}" Width="{c:Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType={x:Type GroupBox}},Path=ActualWidth*0.93}" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40*"/>
                <ColumnDefinition Width="60*"/>
                <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Margin="0,0,2,0" FontSize="12" FontWeight="Normal" Foreground="#FF496180" FontFamily="Arial" HorizontalAlignment="Left" VerticalAlignment="Center" TextWrapping="Wrap"
                       ToolTip="{Binding Converter={StaticResource BitToolTip_Converter}}" Text="{Binding ParamName}" />
            <Button Grid.Column="1" Style="{StaticResource ButtonRoundedWhite}" Cursor="Hand" Command="{Binding DataContext.UtilityCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}}" CommandParameter="{Binding }" 
                    HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="26" Margin="1,0" BorderBrush="#FFE1E7EF" BorderThickness="1" Foreground="#FF0A3C7F" FontFamily="Arial" FontSize="12" FontWeight="Normal"
                    IsEnabled="{Binding isEnable}" Opacity="{Binding isEnable, Converter={StaticResource BitOpacityConverter}}">
                <Button.Background>
                    <MultiBinding Converter="{StaticResource BitBackgroundConverter}">
                        <Binding Path="isEnable" UpdateSourceTrigger="PropertyChanged"/>
                        <Binding Path="BitBackColor" />
                    </MultiBinding>
                </Button.Background>
                <Button.Content>
                    <MultiBinding Converter="{StaticResource BitButtonContentConverter}">
                        <Binding Path="DataContext.CurrentChip.ChipName" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=Page}"/>
                        <Binding />
                    </MultiBinding>
                </Button.Content>
            </Button>

            <Image ToolTipService.ShowDuration="60000" Grid.Column="2" Margin="5 0 0 0" Width="12" Height="12" Source="/VirtualBenchPro_v4;component/Images/info@3x.png" Visibility="{Binding HelpInfo,Converter={StaticResource helpInfoImgConverter}}" >
                <Image.ToolTip>
                    <ToolTip BorderBrush="Transparent" Background="Transparent">
                        <Border CornerRadius="5" Background="#0c98ff">
                            <StackPanel Orientation="Vertical" Margin="5">
                                <TextBlock TextWrapping="Wrap" FontFamily="Arial" Foreground="White" Background="Transparent" Text="{Binding HelpInfo, Converter={StaticResource stringInfoConverter}, ConverterParameter=Tip}" MaxWidth="300"/>
                                <Image Source="{Binding HelpInfo, Converter={StaticResource stringInfoConverter}, ConverterParameter=Image}" Margin="5 0"/>
                            </StackPanel>
                        </Border>
                    </ToolTip>
                </Image.ToolTip>
            </Image>
        </Grid>
    </DataTemplate>


    <Style x:Key="BMSLED" BasedOn="{StaticResource MaterialDesignSwitchToggleButton}"  TargetType="{x:Type ToggleButton}">
