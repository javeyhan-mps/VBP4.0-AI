    <DataTemplate x:Key="DetailRegMap_BitReadOnlyComboxTemplate">
        <Grid Margin="3 0">
            <ComboBox x:Name="BitReadOnlyCombox" Foreground="#FF0A3C7F" MinHeight="20" FontWeight="Normal" IsEditable="False" Background="#F0F0F0"
                      VerticalAlignment="Center" HorizontalAlignment="Stretch" FontFamily="Arial" FontSize="11"
                      ItemsSource="{Binding PossibleValues,Converter={StaticResource pvc}}" 
                      SelectedItem="{Binding CurrentRawBitValue,Mode=OneWay}" >
                <!--User can drop down but can't change item-->
