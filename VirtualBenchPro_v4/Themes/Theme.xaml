                                    <TextBlock Grid.Row="1" Margin="10 0 0 0" FontSize="12" FontWeight="Normal" Foreground="#FF496180" FontFamily="Arial" Opacity="0.5" Padding="5" TextWrapping="Wrap" MinWidth="500">
                                        <!--Content="{Binding DataContext.CurrentChip,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page},Converter={StaticResource NoteContentConverter},ConverterParameter='Tip'}">-->
