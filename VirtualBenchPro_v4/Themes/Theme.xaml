    <!--#Region Template for WinDetailRegisterMap-->
    <LocalSelector:DetailRegMap_BitControlSelector x:Key="DetailRegMap_bitSelector" />
    <LocalConverter:DetailRegMap_BitRangeConverter x:Key="DetailRegMap_BitRangeConverter"/>
    <LocalConverter:DetailRegMap_BitValueConverter x:Key="DetailRegMap_BitValueConverter"/>
    <LocalConverter:DetailRegMap_OperationEnableConverter x:Key="DetailRegMap_OperationEnableConverter"/>
    <LocalConverter:DetailRegMap_BitBackgroundConverter x:Key="DetailRegMap_BitBackgroundConverter"/>

    <DataTemplate x:Key="DetailRegMap_BitTextBoxTemplate">
        <Grid Margin="3 0">
            <TextBlock Grid.Column="0" Text="0x" Width="16" FontSize="11" FontWeight="Normal" FontFamily="Arial" HorizontalAlignment="Left" VerticalAlignment="Center" 
                       Padding="4 0 0 0" Panel.ZIndex="99" Background="Transparent" Foreground="{Binding ElementName=txtValue, Path=Foreground}" />

            <TextBox x:Name="txtValue" Grid.Column="0" FontSize="11" FontWeight="Normal" FontFamily="Arial" Height="20" Padding="14 0 3 0" Margin="0 0 0 0" 
                       BorderBrush="#e1e7ef" BorderThickness="1" VerticalContentAlignment="Center" HorizontalAlignment="Stretch"
                     IsEnabled="{Binding isEnable}" IsReadOnly="false" Validation.ErrorTemplate="{x:Null}" FocusVisualStyle="{x:Null}">
                <!--<TextBox.Text>
                    <Binding Path="CurrentRawBitValue" UpdateSourceTrigger="PropertyChanged" Mode="TwoWay" >
                        <Binding.ValidationRules>
                            <viewmodel:RawBitValueRule/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>-->
                <TextBox.Text>
                    <Binding Path="CurrentRawBitValue" UpdateSourceTrigger="LostFocus" ValidatesOnDataErrors="True" />
                </TextBox.Text>
                <TextBox.Background>
                    <MultiBinding Converter="{StaticResource DetailRegMap_BitBackgroundConverter}">
                        <Binding Path="CurrentRawBitValue" />
                        <Binding Path="SourceRawBitValue" />
                        <Binding Path="isEnable" UpdateSourceTrigger="PropertyChanged"/>
                    </MultiBinding>
                </TextBox.Background>
                <TextBox.Style>
                    <Style TargetType="{x:Type TextBox}">
                        <Style.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="Foreground" Value="#FF0A3C7F" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="false">
                                <Setter Property="Foreground" Value="#FF0A3C7F" />
                            </Trigger>

                            <Trigger Property="Validation.HasError" Value="true">
                                <Setter Property="ToolTip"  Value="{Binding RelativeSource={x:Static RelativeSource.Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
                            </Trigger>
                            <Trigger Property="Validation.HasError" Value="True">
                                <Setter Property="Foreground" Value="IndianRed" />
                            </Trigger>
                            <Trigger Property="Validation.HasError" Value="False">
                                <Setter Property="Foreground" Value="#FF0A3C7F" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
                <TextBox.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="5" />
                    </Style>
                </TextBox.Resources>
            </TextBox>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="DetailRegMap_BitComboxTemplate">
        <Grid Margin="3 0">
            <ComboBox Foreground="#FF0A3C7F" BorderBrush="#e1e7ef" FontFamily="Arial" FontWeight="Normal" FontSize="11" 
                      VerticalAlignment="Center" HorizontalAlignment="Stretch" MinHeight="20" 
                      ItemsSource="{Binding PossibleValues,Converter={StaticResource pvc}}"
                      SelectedItem="{Binding CurrentRawBitValue,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                      IsEnabled="{Binding isEnable, UpdateSourceTrigger=PropertyChanged}" 
                      Opacity="{Binding isEnable, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BitOpacityConverter}}" >
                <!--<ComboBox.Background>
                    <MultiBinding Converter="{StaticResource BitBackgroundConverter}">
                        <Binding Path="isEnable" UpdateSourceTrigger="PropertyChanged"/>
                        <Binding Path="BitBackColor" />
                    </MultiBinding>
                </ComboBox.Background>-->
                <ComboBox.Background>
                    <MultiBinding Converter="{StaticResource DetailRegMap_BitBackgroundConverter}">
                        <Binding Path="CurrentRawBitValue" />
                        <Binding Path="SourceRawBitValue" />
                        <Binding Path="isEnable" UpdateSourceTrigger="PropertyChanged"/>
                    </MultiBinding>
                </ComboBox.Background>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding }" TextWrapping="WrapWithOverflow" MaxWidth="300" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="DetailRegMap_BitReadOnlyTextBoxTemplate">
        <Grid Margin="5 0">
