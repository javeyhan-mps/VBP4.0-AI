                <!--Mode Selection Parameters-->
                <GroupBox Grid.Column="1" HorizontalAlignment="Stretch" MinHeight="50" VerticalAlignment="Top" BorderBrush="Transparent" Foreground="#FF0A3C7F" Visibility="{Binding ModeSelectParameter, Converter={StaticResource RegionParamsVisibleConverter}}">
                    <GroupBox.Style>
                        <Style TargetType="{x:Type GroupBox}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate>
                                        <Grid Width="{c:Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType={x:Type GroupBox}}, Path=ActualWidth*0.93}" >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40*"/>
                                                <ColumnDefinition Width="60*"/>
                                                <ColumnDefinition Width="20"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Margin="0,0,2,0" Grid.Column="0" Text="{Binding ModeSelectParameter.Name}" HorizontalAlignment="Left" FontFamily="Arial" VerticalAlignment="Center" FontSize="12" FontWeight="Normal"  TextWrapping="Wrap" Foreground="#FF496180"/>
                                            <ComboBox Grid.Column="1" Foreground="#FF0A3C7F" BorderBrush="#e1e7ef" FontFamily="Arial" VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="20" FontWeight="Normal" FontSize="11" 
                                                      SelectedItem="{Binding ModeSelectParameter.SelectedModeName, Mode=TwoWay}" ItemsSource="{Binding ModeSelectParameter.ModesSelection, Mode=OneWay}" >
                                                <j:Interaction.Triggers>
                                                    <j:EventTrigger EventName="SelectionChanged">
                                                        <j:InvokeCommandAction Command="{Binding DataContext.PageSelectCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}}"/>
                                                    </j:EventTrigger>
                                                </j:Interaction.Triggers>
                                            </ComboBox>

                                            <Image ToolTipService.ShowDuration="60000" Grid.Column="2"  Margin="5 0 0 0" Width="12" Height="12"  Source="/VirtualBenchPro_v4;component/Images/info@3x.png"  Visibility="{Binding ModeSelectParameter.Info,Converter={StaticResource helpInfoImgConverter}}" >
                                                <Image.ToolTip>
                                                    <ToolTip BorderBrush="Transparent" Background="Transparent">
                                                        <Border CornerRadius="5" Background="#0c98ff">
                                                            <StackPanel Orientation="Vertical" Margin="5">
                                                                <TextBlock TextWrapping="Wrap" FontFamily="Arial" Foreground="White" Text="{Binding ModeSelectParameter.Info, Converter={StaticResource stringInfoConverter}, ConverterParameter=Tip}" MaxWidth="300" Background="Transparent" />
                                                                <Image Source="{Binding ModeSelectParameter.Info, Converter={StaticResource stringInfoConverter}, ConverterParameter=Image}" Margin="5 0"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </ToolTip>
                                                </Image.ToolTip>
                                            </Image>
                                        </Grid>

                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupBox.Style>
                </GroupBox>

                <!--<Rectangle Grid.Row="1" Grid.ColumnSpan="2" Fill="Red" Height="1" Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type StackPanel}},Path=ActualWidth}"/>-->
            </Grid>

