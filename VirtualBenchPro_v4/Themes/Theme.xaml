    <DataTemplate x:Key="DetailRegMap_BitSendByteButtonTemplate">
        <Grid Margin="3 0" >
            <Button Style="{StaticResource ButtonRoundedWhite}" Cursor="Hand" Margin="5 0" Height="20" FontFamily="Arial" FontSize="12" FontWeight="Normal"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center" BorderBrush="#FF0A3C7F" Foreground="#FF0A3C7F" BorderThickness="1"
                    Content="Send Byte" MaxWidth="150"
                    IsEnabled="{Binding isEnable}" Opacity="{Binding isEnable, Converter={StaticResource BitOpacityConverter}}"
                    Command="{Binding DataContext.SendByteCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}" >
                <Button.Background>
