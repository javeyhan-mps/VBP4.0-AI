<Window x:Class="VirtualBenchPro_v4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:attachedBehaviors="clr-namespace:VirtualBenchPro_v4.AttachedBehaviors"
        xmlns:localView="clr-namespace:VirtualBenchPro_v4.Views.CustomElements"
        xmlns:local="clr-namespace:VirtualBenchPro_v4"
       
        mc:Ignorable="d"
        Title="Virtual Bench Pro 4.0"  WindowStartupLocation="CenterScreen" BorderThickness="0" Margin="0" Icon="Images/logo.png" WindowStyle="None" StateChanged="Window_StateChanged" SnapsToDevicePixels="True" MinHeight="620" MinWidth="1230" Background="#FFF8F9FB"
        Loaded="Window_Loaded" LocationChanged="Window_LocationChanged">
    <!--Height="759" Width="1367"-->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" />
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="37"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="0" Grid.ColumnSpan="2" MouseDown="Grid_MouseDown" Margin="0,0,0,0">
            <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <LinearGradientBrush.RelativeTransform>
                        <TransformGroup>
                            <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                            <SkewTransform CenterY="0.5" CenterX="0.5"/>
                            <RotateTransform Angle="90" CenterY="0.5" CenterX="0.5"/>
                        </TransformGroup>
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#FF03C2FF"/>
                    <GradientStop Color="#FF1C4EFF" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Image HorizontalAlignment="Left" Width="50" Source="Images/logo.png" Margin="15,0,0,0"/>
            <Label Content="Virtual Bench Pro 4.0" HorizontalAlignment="Left" Margin="70,0,0,0" FontFamily="Arial" VerticalContentAlignment="Center" Foreground="White"/>
            <Label Content="{Binding Project_Title}" FontFamily="Arial" VerticalContentAlignment="Center" Foreground="White" HorizontalContentAlignment="Center" FontSize="14"/>

            <Button x:Name="Minimize_Button" BorderBrush="{x:Null}" Click="Minimize_Button_Click" Width="45" HorizontalAlignment="Right" Margin="0,0,92,9" >
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Grid Background="{TemplateBinding Background}">
                                        <Image Source="Images/remove_white_48x48.png" Margin="0,5" VerticalAlignment="Stretch" />
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="Maximize_Button" BorderBrush="{x:Null}" Click="Maximize_Button_Click" Width="45" HorizontalAlignment="Right" Margin="0,0,46,9" >
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Grid Background="{TemplateBinding Background}">
                                        <Image Source="{Binding Maximize_Restore_Icon}" Margin="0,5" VerticalAlignment="Stretch" />
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="Close_Button" BorderBrush="{x:Null}" Click="Close_Button_Click" Width="45" HorizontalAlignment="Right" Margin="0,0,0,9" >
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Grid Background="{TemplateBinding Background}">
                                        <Image Source="Images/close_white_48x48.png" Margin="0,5" VerticalAlignment="Stretch" />
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFE21122"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>


        </Grid>
        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,0" Background="#FFEAEAEA">
            <Menu Width="Auto" Height="18" Background="{x:Null}">
                <MenuItem Header="_File" FontFamily="Arial" FontSize="14" Background="#FFEAEAEA" BorderBrush="{x:Null}" Template="{StaticResource rootMenuItem}">
                    <MenuItem x:Name="ProjNew" Header="_New" Click="Proj_New_Click" Background="#FFEAEAEA" BorderThickness="0,0,0,1" BorderBrush="#FFC2C2C2" Height="26"/>
                    <MenuItem x:Name="ProjOpen" Header="_Open" Click="Proj_Open_Click" Background="#FFEAEAEA" BorderThickness="0,0,0,1" BorderBrush="#FFC2C2C2" Height="26"/>
                    <MenuItem x:Name="ProjSave" Header="_Save" Click="Proj_Save_Click" Background="#FFEAEAEA" BorderThickness="0,0,0,1" BorderBrush="#FFC2C2C2" Height="26" IsEnabled="False" Opacity="0.5"/>
                    <MenuItem x:Name="ProjSaveAs" Header="_Save As..." Click="Proj_Save_As_Click" Background="#FFEAEAEA" BorderThickness="0,0,0,1" BorderBrush="#FFC2C2C2" Height="26" IsEnabled="False" Opacity="0.5"/>
                    <MenuItem x:Name="ProjImportTxt" Header="_Import ATE file" Click="ProjImportTxt_Click" Background="#FFEAEAEA" BorderThickness="0,0,0,1" BorderBrush="#FFC2C2C2" Height="26"/>
                    <MenuItem x:Name="ProjClose" Header="_Close" Click="Proj_Close_Click" Background="#FFEAEAEA" BorderThickness="0,0,0,1" BorderBrush="#FFC2C2C2" Height="26"/>
                    <MenuItem x:Name="ProjExit" Header="_Exit" Click="Proj_Exit_Click" Background="#FFEAEAEA" BorderThickness="0" BorderBrush="#FFC2C2C2" Height="26"/>
                </MenuItem>
                <MenuItem Header="_Help" FontFamily="Arial" FontSize="14" Template="{StaticResource rootMenuItem}">
                    <MenuItem x:Name="UserManual" Header="_User Manual" Click="Help_User_Manual_Click" Background="#FFEAEAEA" BorderThickness="0,0,0,1" BorderBrush="#FFC2C2C2" Height="26"/>
                    <MenuItem x:Name="UpdateCheck" Header="_Check for GUI Updates" Click="Help_Update_Check_Click" Background="#FFEAEAEA" BorderThickness="0,0,0,1" BorderBrush="#FFC2C2C2" Height="26"/>
                    <MenuItem x:Name="KitCheck" Header="_Check Kit Version" Click="Help_Kit_Check_Click" Background="#FFEAEAEA" BorderThickness="0,0,0,1" BorderBrush="#FFC2C2C2" Height="26"/>
                    <MenuItem x:Name="About" Header="_About VB Pro" Click="Help_About_Click" Background="#FFEAEAEA" BorderThickness="0" BorderBrush="#FFC2C2C2" Height="26"/>
                    <MenuItem x:Name="License" Header="_License" Click="License_Click" Background="#FFEAEAEA" BorderThickness="0" BorderBrush="#FFC2C2C2" Height="26"/>
            </MenuItem>
            </Menu>
        </Grid>
        <Grid x:Name="Menu" Grid.Column="0" Grid.Row="2" Background="#FF153C7E">
            <DockPanel Grid.Row="0" Margin="0,0,0,0">
                <Button x:Name="System_Button" VerticalAlignment="Top" Height="74"  BorderBrush="{x:Null}" Click="System_Button_Click" Background="#FF1C4EFF" DockPanel.Dock="Top" >
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Grid Background="{TemplateBinding Background}">
                                            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" Orientation="Vertical" Width="Auto" Margin="0"  >
                                                <Image x:Name="System_Button_Icon" Source="Images/system-copy@3x.png" Width="29" Margin="0,0,0,5" />
                                                <Label Content="System" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0" Foreground="#FFF8FAFB" FontFamily="Arial" Margin="0" FontSize="16"/>
                                            </StackPanel>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF2B4CFE"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="Device_Button" VerticalAlignment="Top" Height="74" BorderBrush="{x:Null}" Click="Device_Button_Click" DockPanel.Dock="Top" Content="Device" Foreground="White" Background="#FF0A3C7F" Opacity="0.5">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Grid Background="{TemplateBinding Background}">
                                            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" Orientation="Vertical" Width="Auto" Margin="0"  >
                                                <Image x:Name="Device_Button_Icon" Source="Images/device@3x.png" Width="29" Margin="0,0,0,5" />
                                                <Label Content="{TemplateBinding Content}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0" Foreground="{TemplateBinding Foreground}" FontFamily="Arial" Margin="0" FontSize="16"/>
                                            </StackPanel>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF2B4CFE"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="Project_Tools_Button" VerticalAlignment="Top" Height="74" BorderBrush="{x:Null}" Panel.ZIndex="1" Cursor="Hand" Click="Evaluation_View_Button_Click" DockPanel.Dock="Top" Foreground="White" Content="Support" Opacity="0.5" Background="#FF153C7E">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Grid Background="{TemplateBinding Background}">
                                            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" Orientation="Vertical" Width="Auto" Margin="0"  >
                                                <Image x:Name="Project_Tools_Button_Icon" Source="Images/tools-copy@3x.png" Width="29" Margin="0,0,0,5" />
                                                <Label Content="{TemplateBinding Content}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0" Foreground="{TemplateBinding Foreground}" FontFamily="Arial" Margin="0" FontSize="16"/>
                                            </StackPanel>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF2058B6"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="UCSM_Button" VerticalAlignment="Top" Height="74" BorderBrush="{x:Null}" Click="UCSM_Button_Click" DockPanel.Dock="Top" Content="UCSM" 
                        Foreground="White" Opacity="0.5" Background="#FF0A3C7F" >
                    <Button.Visibility>
                        <MultiBinding Converter="{StaticResource UCSMConverter}">
                            <Binding Path="Configs"></Binding>
                            <Binding Path="LicenseInfo"></Binding>
                        </MultiBinding>
                    </Button.Visibility>
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Grid Background="{TemplateBinding Background}">
                                            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" Orientation="Vertical" Width="Auto" Margin="0"  >
                                                <Image x:Name="UCSM_Button_Icon" Source="Images/ucsm-copy@3x.png" Width="29" Margin="0,0,0,5" />
                                                <Label Content="{TemplateBinding Content}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0" Foreground="{TemplateBinding Foreground}" FontFamily="Arial" Margin="0" FontSize="16"/>
                                            </StackPanel>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF2B4CFE"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>


                <Button x:Name="RegisterTool_Button" VerticalAlignment="Top" Height="74" BorderBrush="{x:Null}" Click="RegisterTool_Button_Click" DockPanel.Dock="Top" Content="Register Tool" 
                        Foreground="White" Opacity="0.5" Background="#FF0A3C7F" >
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Grid Background="{TemplateBinding Background}">
                                            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" Orientation="Vertical" Width="Auto" Margin="0"  >
                                                <Image x:Name="Online_Button_Icon" Source="Images/online-copy@3x.png" Width="29" Margin="0,0,0,5" />
                                                <Label Content="{TemplateBinding Content}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0" Foreground="{TemplateBinding Foreground}" FontFamily="Arial" Margin="0" FontSize="16"/>
                                            </StackPanel>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF2B4CFE"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
            </Button>
            </DockPanel>

        </Grid>
        <Grid x:Name="MainContent" Grid.Column="1" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="25" />
               
            </Grid.RowDefinitions>
            <Grid Background="Gray" Grid.RowSpan="2" Panel.ZIndex="99" Opacity="0.4" Visibility="{Binding UIEnabled, Converter={StaticResource bgConverter}}" />
            <Frame x:Name="Main_View"  NavigationUIVisibility="Hidden"  />
          
            <StackPanel x:Name="license_info" Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Right" Margin="0 0 10 5" Visibility="{Binding LicenseInfo.Status, Converter={StaticResource LicenseStatusConverter}, ConverterParameter=all}">
                <TextBlock Text="This software is licensed for " FontFamily="Arial" Foreground="#FF9EACBF" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Name="Customer_tb" Text="{Binding LicenseInfo.Customer}"  FontFamily="Arial" Foreground="#FF9EACBF" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Text=" use."  FontFamily="Arial" Foreground="#FF9EACBF" FontSize="13" VerticalAlignment="Center"/>
                <localView:LicenseActive Height="20" Width="116" Margin="10 0 5 0" Visibility="{Binding LicenseInfo.Status, Converter={StaticResource LicenseStatusConverter}, ConverterParameter=active}"/>
                <localView:LicenseInactive Height="20" Width="116" Margin="10 0 5 0" Visibility="{Binding LicenseInfo.Status, Converter={StaticResource LicenseStatusConverter}, ConverterParameter=inactive}"/>
                <localView:LicenseExpired Height="20" Width="116" Margin="10 0 5 0" Visibility="{Binding LicenseInfo.Status, Converter={StaticResource LicenseStatusConverter}, ConverterParameter=expired}"/>
                <!--<localView:LicenseExpiring Height="20" Width="116" Margin="10 0 5 0" Visibility="{Binding LicenseInfo.Status, Converter={StaticResource LicenseStatusConverter}, ConverterParameter=expiring}"/>-->
                <TextBlock Text="{Binding LicenseInfo.ExpDate, Converter={StaticResource LicenseExpDateConverter}}" FontFamily="Arial" VerticalAlignment="Center" Foreground="#eaa435"  Visibility="{Binding LicenseInfo.Status, Converter={StaticResource LicenseStatusConverter}, ConverterParameter=expdate}"/>
                <localView:LicenseOffline Height="20" Width="116" Margin="10 0 5 0" Visibility="{Binding LicenseInfo.Status, Converter={StaticResource LicenseStatusConverter}, ConverterParameter=offline}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
