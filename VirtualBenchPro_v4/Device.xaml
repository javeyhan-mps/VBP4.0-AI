                        <TabItem Style="{StaticResource TabItem_HeaderFlat}" Header="JEITA Profile" Visibility="{Binding CurrentChip, Converter={StaticResource BatteryTabVisbilityConverter}, ConverterParameter=JEITA}" FontFamily="Arial" FontWeight="Bold" Width="110" Margin="0" FontSize="14" Height="32">
