                                </TabItem>
                                <TabItem Header="NTC Calculate" Style="{StaticResource BlueRoundTabItemStyle}" FontSize="11">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition Height="2*"/>
                                        </Grid.RowDefinitions>
                                        <Image Source="Images/NTCCalculate(1).PNG" Margin="5 0" MouseLeftButtonUp="Image_MouseLeftButtonUp" Cursor="Hand">
                                            <Image.ToolTip>
                                                <ToolTip BorderBrush="Transparent" Background="Transparent">
                                                    <Border CornerRadius="5" Background="#FF0C98FF">
                                                        <TextBlock TextWrapping="Wrap" FontFamily="Arial" Foreground="White" Margin="5" Background="Transparent" Text="Click To Enlarge (Pop-Up)" MaxWidth="300"/>
                                                    </Border>
                                                </ToolTip>
                                            </Image.ToolTip>
                                        </Image>
                                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                            <Grid Grid.Row="1">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition/>
                                                    <RowDefinition Height="1.5*"/>
                                                    <RowDefinition/>
                                                    <RowDefinition Height="0.5*"/>
                                                    <RowDefinition/>
                                                    <RowDefinition Height="0.5*"/>
                                                    <RowDefinition/>
                                                    <RowDefinition Height="1.5*"/>
                                                    <RowDefinition/>
                                                    <RowDefinition Height="1.5*"/>
                                                    <RowDefinition/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="Step 1:Load Temperature NTC Settings in the Advanced Parameters menu" FontSize="14" Foreground="#FF0A3C7F" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                <Grid Grid.Row="1" Margin="5 0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition/>
                                                        <RowDefinition/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Grid.Column="0" FontFamily="Arial" FontWeight="Normal" Foreground="#FF496180" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center" Text="Cold Threshold" Margin="5 2"/>
                                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="NTCColdTxt" IsReadOnly="True" Text="{Binding CurrentPart.strThermistorValue,Converter={StaticResource NTCTxtValueConverter},ConverterParameter='Cold'}" FontFamily="Arial" FontWeight="Normal" Foreground="#FF496180" Style="{DynamicResource TextBoxStyle1}" Background="White" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" BorderBrush="White" MinWidth="35" BorderThickness="0" FontSize="12" Height="26"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="2" FontFamily="Arial" FontWeight="Normal" Foreground="#FF496180" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center" Text="Cool Threshold" Margin="5 2"/>
                                                    <TextBox Grid.Row="0" Grid.Column="3" x:Name="NTCCoolTxt" IsReadOnly="True" Text="{Binding CurrentPart.strThermistorValue,Converter={StaticResource NTCTxtValueConverter},ConverterParameter='Cool'}" FontFamily="Arial" FontWeight="Normal" Foreground="#FF496180" Style="{DynamicResource TextBoxStyle1}" Background="White" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" BorderBrush="White" MinWidth="35" BorderThickness="0" FontSize="12" Height="26"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="0" FontFamily="Arial" FontWeight="Normal" Foreground="#FF496180" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center" Text="Warm Threshold" Margin="5 2"/>
                                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="NTCWarmTxt" IsReadOnly="True" Text="{Binding CurrentPart.strThermistorValue,Converter={StaticResource NTCTxtValueConverter},ConverterParameter='Warm'}" FontFamily="Arial" FontWeight="Normal" Foreground="#FF496180" Style="{DynamicResource TextBoxStyle1}" Background="White" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" BorderBrush="White" MinWidth="35" BorderThickness="0" FontSize="12" Height="26"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="2" FontFamily="Arial" FontWeight="Normal" Foreground="#FF496180" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center" Text="Hot  Threshold" Margin="5 2"/>
                                                    <TextBox Grid.Row="1" Grid.Column="3" x:Name="NTCHotTxt" IsReadOnly="True" Text="{Binding CurrentPart.strThermistorValue,Converter={StaticResource NTCTxtValueConverter},ConverterParameter='Hot'}" FontFamily="Arial" FontWeight="Normal" Foreground="#FF496180" Style="{DynamicResource TextBoxStyle1}" Background="White" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" BorderBrush="White" MinWidth="35" BorderThickness="0" FontSize="12" Height="26"/>
                                                </Grid>
                                                <TextBlock Grid.Row="2" Text="Step 2:Please enter the resistance value of NTC at 25°C and  β-factor of NTC" FontSize="14" Foreground="#FF0A3C7F" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                <Grid Grid.Row="3" Margin="5 0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Width="60" Grid.Column="0" FontFamily="Arial" FontWeight="Normal" Foreground="#FF496180" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center" Text="RNTC(kΩ)" Margin="5 2"/>
                                                    <TextBox x:Name="RNTCTxt" Grid.Column="1" FontFamily="Arial" FontWeight="Normal" Foreground="#FF496180" Style="{DynamicResource TextBoxStyle1}" Background="#FFCEDFF6" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" BorderBrush="White" MinWidth="35" MaxWidth="80" HorizontalAlignment="Left" Text="{Binding CurrentChip.Monitor.RNTCValue}" FontSize="12" Height="26" BorderThickness="0" TextChanged="Txt_TextChanged"/>
                                                    <TextBlock Width="60" Grid.Column="2" FontFamily="Arial" FontWeight="Normal" Foreground="#FF496180" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center" Text="β-factor(K)" Margin="5 2"/>
                                                    <TextBox x:Name="βFactorTxt" Grid.Column="3" FontFamily="Arial" FontWeight="Normal" Foreground="#FF496180" Style="{DynamicResource TextBoxStyle1}" Background="#FFCEDFF6" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" BorderBrush="White" MinWidth="35" MaxWidth="80" HorizontalAlignment="Left" Text="{Binding CurrentChip.Monitor.FactValue}" FontSize="12" Height="26" BorderThickness="0" TextChanged="Txt_TextChanged"/>
                                                </Grid>
                                                <TextBlock Grid.Row="4" Text="Step 3:Please input Pull up resistor RT1 and parallel resistor RT2" FontSize="14" Foreground="#FF0A3C7F" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                <Grid Grid.Row="5" Margin="5 0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Width="60" Grid.Column="0" FontFamily="Arial" FontWeight="Normal" Foreground="#FF496180" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center" Text="Rpull(kΩ)" Margin="5 2"/>
                                                    <TextBox x:Name="Rt1Txt" Grid.Column="1" FontFamily="Arial" FontWeight="Normal" Foreground="#FF496180" Style="{DynamicResource TextBoxStyle1}" Background="#FFCEDFF6" HorizontalContentAlignment="Left" HorizontalAlignment="Left" VerticalContentAlignment="Center" BorderBrush="White" MinWidth="35" MaxWidth="80" Text="{Binding CurrentChip.Monitor.RPullValue}" FontSize="12" Height="26" BorderThickness="0" TextChanged="Txt_TextChanged" />
                                                    <TextBlock Width="60" Grid.Column="2" FontFamily="Arial" FontWeight="Normal" Foreground="#FF496180" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center" Text="Rp(kΩ)" Margin="5 2"/>
                                                    <TextBox x:Name="Rt2Txt" Grid.Column="3" FontFamily="Arial" FontWeight="Normal" Foreground="#FF496180" Style="{DynamicResource TextBoxStyle1}" Background="#FFCEDFF6" HorizontalContentAlignment="Left" HorizontalAlignment="Left" VerticalContentAlignment="Center" BorderBrush="White" MinWidth="35" MaxWidth="80" Text="{Binding CurrentChip.Monitor.RpValue}" FontSize="12" Height="26" BorderThickness="0" TextChanged="Txt_TextChanged"/>
                                                </Grid>
                                                <TextBlock Grid.Row="6" Text="Step 4:Calculate RNTC @ threshold" FontSize="14" Foreground="#FF0A3C7F" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                <Grid Grid.Row="7" Margin="5 0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition/>
                                                        <RowDefinition/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Grid.Column="0" FontFamily="Arial" FontWeight="Normal" Foreground="#FF496180" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center" Text="Cold Resistance(kΩ)" Margin="5 2"/>
                                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="Cold_ResistanceTxt" IsReadOnly="True" FontFamily="Arial" FontWeight="Normal" Foreground="#FF496180" Style="{DynamicResource TextBoxStyle1}" Background="White" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" BorderBrush="White" MinWidth="35" BorderThickness="0" FontSize="12" Height="26">
                                                        <TextBox.Text>
                                                            <MultiBinding Converter="{StaticResource NTCResistanceTxtValueConverter}" ConverterParameter="Cold">
                                                                <Binding Path="CurrentPart.strThermistorValue"/>
                                                                <Binding ElementName="Rt1Txt"  Path="Text"/>
                                                                <Binding ElementName="Rt2Txt"  Path="Text"/>
                                                            </MultiBinding>
                                                        </TextBox.Text>
                                                    </TextBox>
                                                    <TextBlock Grid.Row="0" Grid.Column="2" FontFamily="Arial" FontWeight="Normal" Foreground="#FF496180" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center" Text="Cool Resistance(kΩ)" Margin="5 2"/>
                                                    <TextBox Grid.Row="0" Grid.Column="3" x:Name="Cool_ResistanceTxt" IsReadOnly="True" FontFamily="Arial" FontWeight="Normal" Foreground="#FF496180" Style="{DynamicResource TextBoxStyle1}" Background="White" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" BorderBrush="White" MinWidth="35" BorderThickness="0" FontSize="12" Height="26">
                                                        <TextBox.Text>
                                                            <MultiBinding Converter="{StaticResource NTCResistanceTxtValueConverter}" ConverterParameter="Cool">
                                                                <Binding Path="CurrentPart.strThermistorValue"/>
                                                                <Binding ElementName="Rt1Txt"  Path="Text"/>
                                                                <Binding ElementName="Rt2Txt"  Path="Text"/>
                                                            </MultiBinding>
                                                        </TextBox.Text>
                                                    </TextBox>
                                                    <TextBlock Grid.Row="1" Grid.Column="0" FontFamily="Arial" FontWeight="Normal" Foreground="#FF496180" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center" Text="Warm Resistance(kΩ)" Margin="5 2"/>
                                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="Warm_ResistanceTxt" IsReadOnly="True" FontFamily="Arial" FontWeight="Normal" Foreground="#FF496180" Style="{DynamicResource TextBoxStyle1}" Background="White" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" BorderBrush="White" MinWidth="35" BorderThickness="0" FontSize="12" Height="26">
                                                        <TextBox.Text>
                                                            <MultiBinding Converter="{StaticResource NTCResistanceTxtValueConverter}" ConverterParameter="Warm">
                                                                <Binding Path="CurrentPart.strThermistorValue"/>
                                                                <Binding ElementName="Rt1Txt"  Path="Text"/>
                                                                <Binding ElementName="Rt2Txt"  Path="Text"/>
                                                            </MultiBinding>
                                                        </TextBox.Text>
                                                    </TextBox>
                                                    <TextBlock Grid.Row="1" Grid.Column="2" FontFamily="Arial" FontWeight="Normal" Foreground="#FF496180" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center" Text="Hot  Resistance(kΩ)" Margin="5 2"/>
                                                    <TextBox Grid.Row="1" Grid.Column="3" x:Name="Hot_ResistanceTxt" IsReadOnly="True" FontFamily="Arial" FontWeight="Normal" Foreground="#FF496180" Style="{DynamicResource TextBoxStyle1}" Background="White" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" BorderBrush="White" MinWidth="35" BorderThickness="0" FontSize="12" Height="26">
                                                        <TextBox.Text>
                                                            <MultiBinding Converter="{StaticResource NTCResistanceTxtValueConverter}" ConverterParameter="Hot">
                                                                <Binding Path="CurrentPart.strThermistorValue"/>
                                                                <Binding ElementName="Rt1Txt"  Path="Text"/>
                                                                <Binding ElementName="Rt2Txt"  Path="Text"/>
                                                            </MultiBinding>
                                                        </TextBox.Text>
                                                    </TextBox>
                                                </Grid>

                                                <TextBlock Grid.Row="8" Text="Step 5:Calculate temperature @ threshold" FontSize="14" Foreground="#FF0A3C7F" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                <Grid Grid.Row="9" Margin="5 0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition/>
                                                        <RowDefinition/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Grid.Column="0" FontFamily="Arial" FontWeight="Normal" Foreground="#FF496180" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center" Text="Cold Temperature(℃)" Margin="5 2"/>
                                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="Cold_TemperatureTxt" IsReadOnly="True" FontFamily="Arial" FontWeight="Normal" Foreground="#FF496180" Style="{DynamicResource TextBoxStyle1}" Background="White" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" BorderBrush="White" MinWidth="35" BorderThickness="0" FontSize="12" Height="26">
                                                        <TextBox.Text>
                                                            <MultiBinding Converter="{StaticResource NTCTemperatureValueConverter}">
                                                                <Binding ElementName="Cold_ResistanceTxt" Path="Text"/>
                                                                <Binding ElementName="RNTCTxt"  Path="Text"/>
                                                                <Binding ElementName="βFactorTxt"  Path="Text"/>
                                                            </MultiBinding>
                                                        </TextBox.Text>
                                                    </TextBox>
                                                    <TextBlock Grid.Row="0" Grid.Column="2" FontFamily="Arial" FontWeight="Normal" Foreground="#FF496180" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center" Text="Cool Temperature(℃)" Margin="5 2"/>
                                                    <TextBox Grid.Row="0" Grid.Column="3" x:Name="Cool_TemperatureTxt" IsReadOnly="True" FontFamily="Arial" FontWeight="Normal" Foreground="#FF496180" Style="{DynamicResource TextBoxStyle1}" Background="White" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" BorderBrush="White" MinWidth="35" BorderThickness="0" FontSize="12" Height="26">
                                                        <TextBox.Text>
                                                            <MultiBinding Converter="{StaticResource NTCTemperatureValueConverter}" ConverterParameter="Cool;T">
                                                                <Binding ElementName="Cool_ResistanceTxt" Path="Text"/>
                                                                <Binding ElementName="RNTCTxt"  Path="Text"/>
                                                                <Binding ElementName="βFactorTxt"  Path="Text"/>
                                                            </MultiBinding>
                                                        </TextBox.Text>
                                                    </TextBox>
                                                    <TextBlock Grid.Row="1" Grid.Column="0" FontFamily="Arial" FontWeight="Normal" Foreground="#FF496180" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center" Text="Warm Temperature(℃)" Margin="5 2"/>
                                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="Warm_TemperatureTxt" IsReadOnly="True" FontFamily="Arial" FontWeight="Normal" Foreground="#FF496180" Style="{DynamicResource TextBoxStyle1}" Background="White" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" BorderBrush="White" MinWidth="35" BorderThickness="0" FontSize="12" Height="26">
                                                        <TextBox.Text>
                                                            <MultiBinding Converter="{StaticResource NTCTemperatureValueConverter}">
                                                                <Binding ElementName="Warm_ResistanceTxt" Path="Text"/>
                                                                <Binding ElementName="RNTCTxt"  Path="Text"/>
                                                                <Binding ElementName="βFactorTxt"  Path="Text"/>
                                                            </MultiBinding>
                                                        </TextBox.Text>
                                                    </TextBox>
                                                    <TextBlock Grid.Row="1" Grid.Column="2" FontFamily="Arial" FontWeight="Normal" Foreground="#FF496180" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center" Text="Hot  Temperature(℃)" Margin="5 2"/>
                                                    <TextBox Grid.Row="1" Grid.Column="3" x:Name="Hot_TemperatureTxt" IsReadOnly="True" FontFamily="Arial" FontWeight="Normal" Foreground="#FF496180" Style="{DynamicResource TextBoxStyle1}" Background="White" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" BorderBrush="White" MinWidth="35" BorderThickness="0" FontSize="12" Height="26">
                                                        <TextBox.Text>
                                                            <MultiBinding Converter="{StaticResource NTCTemperatureValueConverter}">
                                                                <Binding ElementName="Hot_ResistanceTxt" Path="Text"/>
                                                                <Binding ElementName="RNTCTxt"  Path="Text"/>
                                                                <Binding ElementName="βFactorTxt"  Path="Text"/>
                                                            </MultiBinding>
                                                        </TextBox.Text>
                                                    </TextBox>
                                                </Grid>
                                            </Grid>
                                        </ScrollViewer>
                                    </Grid>
                                </TabItem>

                            </TabControl>
                        </TabItem>

                        <TabItem Style="{StaticResource TabItem_HeaderFlat}" Header="Log Panel"  FontFamily="Arial" FontWeight="Bold" Width="100" Margin="0" FontSize="14" Height="32">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="56"/>
                                </Grid.RowDefinitions>

                                <DataGrid Grid.Row="0" HeadersVisibility="Column" Margin="1,5,1,0" Cursor="Arrow" ItemsSource="{Binding LogData}" ColumnWidth="SizeToCells" SelectionMode="Single" AlternationCount="2" Style="{DynamicResource DGHeaderStyle}" AutoGenerateColumns="False" IsReadOnly="True" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="Transparent" BorderBrush="#FFE8EBE4"  >
                                    <DataGrid.Columns>
                                        <DataGridTextColumn ElementStyle="{StaticResource CellTextCentered}" MinWidth="130" Header="Date and Time" Binding="{Binding DateTime}" FontFamily="Arial" />
                                        <DataGridTextColumn ElementStyle="{StaticResource CellTextCentered}" MinWidth="90"  Header="Register" Binding="{Binding RegisterName}" FontFamily="Arial"/>
                                        <DataGridTextColumn ElementStyle="{StaticResource CellTextCentered}" MinWidth="90"  Header="Address(Hex)" Binding="{Binding RegisterAddress}" FontFamily="Arial"/>
                                        <DataGridTextColumn ElementStyle="{StaticResource CellTextCentered}" MinWidth="90"  Header="Value" Binding="{Binding RegisterValue}" FontFamily="Arial"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Grid Grid.Row="1">
                                    <Button Style="{StaticResource ButtonRoundedWhite}" Cursor="Hand" Content="Clear Logs" Command="{Binding OperateChipComand}" CommandParameter="ClearLog" HorizontalAlignment="Right" Margin="0,0,16,16" VerticalAlignment="Bottom" Width="100" Height="24" BorderBrush="#FFE1E7EF" Foreground="#FF1378FF" FontFamily="Arial" FontSize="14" FontWeight="Normal"/>
                                    <Button Style="{StaticResource ButtonRoundedWhite}" Cursor="Hand" Content="Copy Logs" Command="{Binding OperateChipComand}" CommandParameter="CopyLog" HorizontalAlignment="Right" Margin="0,0,121,16" VerticalAlignment="Bottom" Width="100" Height="24" BorderBrush="#FFE1E7EF" Foreground="#FF1378FF" FontFamily="Arial" FontSize="14" FontWeight="Normal"/>
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>

        </Grid>
    </Grid>
</Page>
