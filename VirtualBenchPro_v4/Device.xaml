<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:j="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
    xmlns:Helper="clr-namespace:VirtualBenchPro_v4.Helper"
    xmlns:attachedBehaviors="clr-namespace:VirtualBenchPro_v4.AttachedBehaviors"
    x:Class="VirtualBenchPro_v4.Views.Device"
    mc:Ignorable="d" Title="Device" Background="#FFF8F9FB">

    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58*"/>
                <ColumnDefinition Width="42*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="50" />
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <Grid Grid.ColumnSpan="2" Grid.Row="0" Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Menu   x:Name="AddDeviceMenu"  Grid.Column="0" Background="White"  Margin="18,6,0,8"  Height="28" Grid.ColumnSpan="2" HorizontalAlignment="Left" Width="112"  Opacity="0.25"    BorderThickness="0.6" IsEnabled="False" >
                    <MenuItem   FontSize="14"  BorderBrush="#FF1378FF"    Background="White"     FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"   Template="{StaticResource NewDeviceMenuItem}" Height="25"   Width="110" >
                        <MenuItem x:Name="Device_Scan"                FontFamily="Arial" Header="Scan"                 FontWeight="Normal"  Command="{Binding OperateChipComand}" CommandParameter="ScanI2C"   BorderThickness="1,1,1,1" BorderBrush="#FF1378FF"  Height="26"
                                  ToolTip="Only Support I2C Devices"/>
                        <MenuItem x:Name="Device_Connect_Manually"    FontFamily="Arial" Header="Connect Manually"     FontWeight="Normal" Command="{Binding OperateChipComand}" CommandParameter="AddDevice"  BorderThickness="1,0,1,1" BorderBrush="#FF1378FF" Height="26"/>
                        <!--<MenuItem x:Name="Device_Add_Detached_Device" FontFamily="Arial" Header="Add Detached Device"  FontWeight="Normal"  Command="{Binding OperateChipComand}" CommandParameter="Virtual"   BorderThickness="1,1,1,1" BorderBrush="#FF1378FF" Height="26"/>-->
                    </MenuItem>
                </Menu>

                <Grid Grid.Column="1" Margin="10,0,0,0">
                    <Button x:Name="Scroll_Left_Button" HorizontalAlignment="Left" Width="15" BorderBrush="{x:Null}" FontFamily="Arial" FontSize="18" Foreground="{x:Null}" Padding="0" Click="Scroll_Left_Button_Click"  Margin="0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate>
                                            <Grid Background="{TemplateBinding Background}">
                                                <Path xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Name="path86" Stroke="#FF1378FF" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M6.4 9.5L1 5 6.4.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFC5F1FF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!--<ScrollViewer x:Name="Module_Slider" VerticalScrollBarVisibility="Disabled" Margin="15,0,31,0" HorizontalScrollBarVisibility="Hidden">
                <StackPanel x:Name="Module_Container" Orientation="Horizontal"/>
            </ScrollViewer>-->
                    <ListBox SelectionMode="Single" Grid.Column="1" Name="Module_list" ItemsSource="{Binding ProConfig.Chips}" Margin="15,0,31,0" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Focusable="False" BorderBrush="Transparent" >
                        <j:Interaction.Triggers>
                            <j:EventTrigger EventName="SelectionChanged">
                                <j:InvokeCommandAction Command="{Binding DataContext.ChangeChipSelectionCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}}" CommandParameter="{Binding Path=SelectedItem, ElementName=Module_list}" />
                            </j:EventTrigger>
                        </j:Interaction.Triggers>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="MinWidth" Value="70" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Margin" Value="5 0 0 0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Cursor="Hand" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center" HorizontalAlignment="Center" 
                                                    Height="{c:Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType={x:Type ListBoxItem}}, Path=ActualHeight * 0.6}"  >
                                                <!--Width="{c:Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType={x:Type ListBoxItem}}, Path=ActualWidth*0.9}" >-->
                                                <StackPanel x:Name="Button_Content" Orientation="Horizontal" Margin="3 0 0 0" >
                                                    <TextBlock x:Name="name_tb" Background="Transparent" FontSize="12" TextWrapping="Wrap" FontFamily="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0">
                                                        <TextBlock.ToolTip>
                                                            <ToolTip BorderBrush="Transparent" Background="Transparent">
                                                                <Border CornerRadius="5" Background="White" BorderBrush="#FF0A3C7F" BorderThickness="1">
                                                                    <TextBlock TextWrapping="Wrap" FontFamily="Arial" Foreground="#FF0A3C7F" Margin="5" Background="Transparent" 
                                                                               Text="{Binding ChipAddr, Converter={StaticResource DeviceAddrToToolTipTextConverter}}" MaxWidth="300"/>
                                                                </Border>
                                                            </ToolTip>
                                                        </TextBlock.ToolTip>
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource ChipNameAddrFriendlyNameConverter}">
                                                                <Binding Path="ChipName" />
                                                                <Binding Path="ChipAddr" />
                                                                <Binding Path="FriendlyName" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                        <TextBlock.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="Connect tile to a different address" Command="{Binding DataContext.ChangeAddressCommand, Source={x:Reference Module_list}}" >
                                                                    <MenuItem.Visibility>
                                                                        <MultiBinding Converter="{StaticResource ChangeAddrMenuItemVisibilityConverter}">
                                                                           <Binding Path="ChipName" />
                                                                           <Binding Path="ChipAddr" />
                                                                        </MultiBinding>
                                                                      </MenuItem.Visibility>
                                                                </MenuItem>
                                                                <MenuItem Header="Set friendly name" Command="{Binding DataContext.SetFriendlyNameCommand, Source={x:Reference Module_list}}"  />
                                                            </ContextMenu>
                                                        </TextBlock.ContextMenu>
                                                    </TextBlock>
                                                    <!--<CustomElements:Status_LED x:Name="Status_LED_Icon" VerticalAlignment="Center" HorizontalAlignment="Center" Width="5" Margin="0,0,3,0" />-->
                                                    <Ellipse Fill="{Binding IsAddrAvalible, Converter={StaticResource IndicatorColorConverter}}" HorizontalAlignment="Center" Height="8" Stroke="WhiteSmoke" VerticalAlignment="Center" Width="8" Margin="3 0 0 0"/>
                                                    <Button x:Name="close_btn" Margin="3,0,3,0" FontSize="11" FocusVisualStyle="{x:Null}" Width="10" Height="10" BorderBrush="Transparent" HorizontalContentAlignment="Center" HorizontalAlignment="Right" VerticalContentAlignment="Center" VerticalAlignment="Center" FontFamily="Arial"  Cursor="Hand" Panel.ZIndex="10">
                                                        <Button.Background>
                                                            <ImageBrush ImageSource="Images/close@3x.png"/>
                                                        </Button.Background>
                                                        <j:Interaction.Triggers>
                                                            <j:EventTrigger EventName="Click">
                                                                <j:InvokeCommandAction Command="{Binding DataContext.DeleteChipCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}}" 
                                                                            CommandParameter="{Binding Content, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBoxItem}}"/>
                                                            </j:EventTrigger>
                                                        </j:Interaction.Triggers>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="true">
                                                    <Setter Property="Background" TargetName="bd" Value="#0A3C7F"/>
                                                    <Setter Property="BorderBrush" TargetName="bd" Value="#0A3C7F"/>
                                                    <Setter Property="Foreground" TargetName="name_tb" Value="White" />
                                                    <Setter Property="Foreground" TargetName="close_btn" Value="White" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="false">
                                                    <Setter Property="Background" TargetName="bd" Value="#C9D5E4"/>
                                                    <Setter Property="BorderBrush" TargetName="bd" Value="#C9D5E4"/>
                                                    <Setter Property="Foreground" TargetName="name_tb" Value="#FFFFFF" />
                                                    <Setter Property="Foreground" TargetName="close_btn" Value="#c9d5e4" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                                <!--<WrapPanel IsItemsHost="True" />-->
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>

                    <Button x:Name="Scroll_Right_Button" HorizontalAlignment="Right" Width="15" BorderBrush="{x:Null}" FontFamily="Arial" FontSize="14" Foreground="#FF979797" Padding="0" Margin="0,0,16,0" Click="Scroll_Right_Button_Click"  Panel.ZIndex="1" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate>
                                            <Grid Background="{TemplateBinding Background}">
                                                <Path xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  Stroke="#FF1378FF" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M1.1 9.5L6.5 5 1.1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFC5F1FF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>


            </Grid>
            <Grid Grid.Row="1" Grid.ColumnSpan="2" Background="#FFF8F9FB">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="223*"/>
                    <ColumnDefinition Width="600*"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="DeviceLeftToolBox" Grid.Row="0" Orientation="Horizontal" Margin="20,10,0,-0.4" HorizontalAlignment="Left" Grid.ColumnSpan="2">
                    <!--<Label HorizontalAlignment="Left"  AllowDrop="False" Focusable="False" IsTabStop="False" Background="{x:Null}" BorderBrush="{x:Null}" FontFamily="Arial" FontSize="16" Padding="0,-2,0,0" Foreground="#FF0A3C7F" VerticalContentAlignment="Center" FontWeight="Bold" TargetUpdated="Label_TargetUpdated">-->
                    <Label HorizontalAlignment="Left"  AllowDrop="False" Focusable="False" IsTabStop="False" Background="{x:Null}" BorderBrush="{x:Null}" FontFamily="Arial" FontSize="16" Padding="0,-2,0,0" Foreground="#FF0A3C7F" VerticalContentAlignment="Center" FontWeight="Bold">
                        <Label.Content>
                            <ContentPresenter Content="{Binding CurrentChip.ChipName, NotifyOnTargetUpdated=True}" RecognizesAccessKey="False" />
                        </Label.Content>
                    </Label>
                    <Label Content="{Binding CurrentChip.ChipAddr, Converter={StaticResource AddrConverter}}" Margin="0 0 0 0" HorizontalAlignment="Left" AllowDrop="False" Focusable="False" IsTabStop="False" Background="{x:Null}" BorderBrush="{x:Null}" FontFamily="Arial" FontSize="16" Padding="0,0,0,0" Foreground="#FF0A3C7F" VerticalContentAlignment="Center" FontWeight="Bold"/>
                    <Label Content="{Binding CurrentChip.FriendlyName, Converter={StaticResource FriendlyNameConverter}}" Margin="0 0 0 0" HorizontalAlignment="Left" AllowDrop="False" Focusable="False" IsTabStop="False" Background="{x:Null}" BorderBrush="{x:Null}" FontFamily="Arial" FontSize="16" Padding="0,0,0,0" Foreground="#FF0A3C7F" VerticalContentAlignment="Center" FontWeight="Bold"/>
                    <Label Content="{Binding CurrentChip.DSVersion, Converter={StaticResource DSVersionConverter}}" Margin="0 0 0 0" HorizontalAlignment="Left" AllowDrop="False" Focusable="False" IsTabStop="False" Background="{x:Null}" BorderBrush="{x:Null}" FontFamily="Arial" FontSize="16" Padding="0,0,0,0" Foreground="#FF0A3C7F" VerticalContentAlignment="Center" FontWeight="Bold"/>
                    <Button x:Name="Export_Button" Grid.Column="0" Margin="13,0,0,0" FontFamily="Arial" BorderBrush="LightGray" HorizontalAlignment="Left" Width="94" Command="{Binding OperateChipComand}" 
                        CommandParameter="MTPexport" Height="25" Foreground="{x:Null}" Visibility="Visible"  >
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Background" Value="#FF1C4EFF"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Margin="-1">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Margin="0,1" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Label Content="Export" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Foreground="White" Padding="0" FontSize="14" />
                                                    <Image Source="Images/export@3x.png" Width="12" Margin="8,0,0,0" Height="10" />
                                                </StackPanel>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF1378FF"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="LightGray" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.IsEnabled>

                            <MultiBinding Converter="{StaticResource OperationEnableConverter}" ConverterParameter="Export" >

                                <Binding Path="CurrentChip"  />
                                <Binding Path="UserLicense" />
                            </MultiBinding>

                        </Button.IsEnabled>
                    </Button>
                    <Button x:Name="Compare_Button" Grid.Column="0" Margin="13,0,0,0" FontFamily="Arial" BorderBrush="LightGray" HorizontalAlignment="Left" Width="94" Command="{Binding OperateChipComand}" 
                            CommandParameter="Compare" Height="25" Foreground="{x:Null}" Visibility="{Binding CurrentChip.ChipName, Converter={StaticResource CompareVisibleConverter}}" 
                            ToolTip="Compare the register values in current device with a saved ATE file.">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Background" Value="#FF1C4EFF"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Margin="-1">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Margin="0,1" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Label Content="Compare" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Foreground="White" Padding="0" FontSize="14" />
                                                    <!--<Image Source="Images/export@3x.png" Width="12" Margin="8,0,0,0" Height="10" />-->
                                                </StackPanel>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF1378FF"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="LightGray" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.IsEnabled>
                            <MultiBinding Converter="{StaticResource CompareButtonEnableConverter}">
                                <Binding Path="CurrentChip"/>
                                <Binding Path="CurrentChip.IsAddrAvalible"/>
                            </MultiBinding>
                        </Button.IsEnabled>
                    </Button>

                </StackPanel>

                <!-->
                    <StackPanel Margin="0,10,400.4,-0.4" Width="100" Orientation="Horizontal" HorizontalAlignment="Right"
                    Visibility="{Binding CurrentChip, Converter={StaticResource ScanI2CVisibilityConverter}}" Grid.Column="1">
                    <Border Margin="0 0 0 0" Height="26" BorderBrush="#FFE9EDF2" BorderThickness="1" CornerRadius="4" Width="26" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Command="{Binding OperateChipComand}" CommandParameter="ScanI2C" Panel.ZIndex="1" Margin="0" Cursor="Hand" Height="24" Background="#00000000" BorderBrush="{x:Null}" BorderThickness="0" >
                            <Button.ToolTip>
                                <ToolTip BorderBrush="Transparent" Background="Transparent">
                                    <Border CornerRadius="5" Background="#FF0A3C7F">
                                        <TextBlock TextWrapping="Wrap" FontFamily="Arial" Foreground="White" Margin="5" Background="Transparent" Text="Search Device Address" MaxWidth="300"/>
                                    </Border>
                                </ToolTip>
                            </Button.ToolTip>
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Setter Property="Background" Value="Transparent"/>

                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#33FFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Canvas Name="I2Cinstance" Width="14" Height="17">
                                <Canvas.ToolTip>
                                    <ToolTip BorderBrush="Transparent" Background="Transparent">
                                        <Border CornerRadius="5" Background="#FF0A3C7F">
                                            <TextBlock TextWrapping="Wrap" FontFamily="Arial" Foreground="White" Margin="5" Background="Transparent" Text="Search Device Address" MaxWidth="300"/>
                                        </Border>
                                    </ToolTip>
                                </Canvas.ToolTip>
                                <Path xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Name="Rectangle2" StrokeThickness="1" Stroke="#FF9EACBF" Data="M0 4.5C0 2.01472 2.01472 0 4.5 0C6.98528 0 9 2.01472 9 4.5C9 6.98528 6.98528 9 4.5 9C2.01472 9 0 6.98528 0 4.5Z">
                                    <Path.RenderTransform>
                                        <TranslateTransform X="1" Y="1"/>
                                    </Path.RenderTransform>
                                </Path>
                                <Path xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Name="Line6Copy2" StrokeThickness="1" Stroke="#FF9EACBF" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M5 6L0 0">
                                    <Path.RenderTransform>
                                        <MatrixTransform Matrix="-1 0 0 -1 13 16"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Canvas>

                        </Button>
                    </Border>
                    <TextBlock Margin="5,5,0,0" FontFamily="Arial" Foreground="#FF3D608F" Width="25" Text="Scan" FontSize="10"  FontWeight="Bold"/>
                </StackPanel> <-->

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin ="0,0,185.4,0">
                    <Border Margin="0,10,5,0" Height="26" BorderBrush="#FFE9EDF2" BorderThickness="1" CornerRadius="4" Width="52" VerticalAlignment="Top">
                        <Grid>
                            <Button x:Name="Non_Volatile_Write_Button" Panel.ZIndex="1" Width="25" Margin="0" Cursor="Hand" HorizontalAlignment="Left" Height="24" BorderBrush="{x:Null}" Background="#00000000" BorderThickness="0" 
                            ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="60000" >
                                <j:Interaction.Triggers>
                                    <j:EventTrigger EventName="Click">
                                        <j:InvokeCommandAction Command="{Binding DataContext.CommunicationCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}}" CommandParameter="ReadRAM" />
                                    </j:EventTrigger>
                                </j:Interaction.Triggers>
                                <Button.ToolTip>
                                    <ToolTip BorderBrush="Transparent" Background="Transparent">
                                        <Border CornerRadius="5" Background="#FF0A3C7F">
                                            <TextBlock TextWrapping="Wrap" FontFamily="Arial" Foreground="White" Margin="5" Background="Transparent" MaxWidth="300">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource OperationToolTipConverter}"  ConverterParameter="ReadRAM" >
                                                        <Binding Path="CurrentChip" />
                                                        <Binding Path="UserLicense" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Border>
                                    </ToolTip>
                                </Button.ToolTip>
                                <Canvas Width="14" Margin="0" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M4.9 4.1L7 .5l2.1 3.6">
                                        <Path.Stroke>
                                            <MultiBinding Converter="{StaticResource OperationStrokeConverter}"  ConverterParameter="ReadRAM" >
                                                <Binding Path="CurrentChip" />
                                                <Binding Path="UserLicense" />
                                            </MultiBinding>
                                        </Path.Stroke>
                                    </Path>
                                    <Path xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M7 9.1V1.3M13.5 8.9v1.8a1.8 1.8 0 0 1-1.8 1.8H2.3a1.8 1.8 0 0 1-1.8-1.8V8.9" >
                                        <Path.Stroke>
                                            <MultiBinding Converter="{StaticResource OperationStrokeConverter}"  ConverterParameter="ReadRAM" >
                                                <Binding Path="CurrentChip" />
                                                <Binding Path="UserLicense" />
                                            </MultiBinding>
                                        </Path.Stroke>
                                    </Path>
                                </Canvas>
                                <Button.IsEnabled>
                                    <MultiBinding Converter="{StaticResource OperationEnableConverter}" ConverterParameter="ReadRAM" >
                                        <Binding Path="CurrentChip"  />
                                        <Binding Path="UserLicense" />
                                    </MultiBinding>
                                </Button.IsEnabled>
                            </Button>
                            <Line X1="26" Y1="0" X2="26" Y2="24" Stroke="#FFE9EDF2"  StrokeThickness="1" Panel.ZIndex="10" />
                            <Button x:Name="Non_Volatile_Read_Button" Command="{Binding CommunicationCommand}" CommandParameter="WriteRAM" HorizontalAlignment="Right" Margin="0" Cursor="Hand" Width="25" BorderBrush="#FFE9EDF2" Padding="1" Background="#00000000" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderThickness="0,0,0,0" Foreground="{x:Null}" 
                            ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="60000" >
                                <Button.ToolTip>
                                    <ToolTip BorderBrush="Transparent" Background="Transparent">
                                        <Border CornerRadius="5" Background="#FF0A3C7F">
                                            <TextBlock TextWrapping="Wrap" FontFamily="Arial" Foreground="White" Margin="5" Background="Transparent" MaxWidth="300"    >
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource OperationToolTipConverter}"  ConverterParameter="WriteRAM" >
                                                        <Binding Path="CurrentChip" />
                                                        <Binding Path="UserLicense" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Border>
                                    </ToolTip>
                                </Button.ToolTip>
                                <Canvas Width="14" Margin="0" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M9.1 5.5L7 9.1 4.9 5.5">
                                        <Path.Stroke>
                                            <MultiBinding Converter="{StaticResource OperationStrokeConverter}"  ConverterParameter="WriteRAM" >
                                                <Binding Path="CurrentChip" />
                                                <Binding Path="UserLicense" />
                                            </MultiBinding>
                                        </Path.Stroke>
                                    </Path>
                                    <Path xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M7 .5v7.8M13.5 8.9v1.8a1.8 1.8 0 0 1-1.8 1.8H2.3a1.8 1.8 0 0 1-1.8-1.8V8.9">
                                        <Path.Stroke>
                                            <MultiBinding Converter="{StaticResource OperationStrokeConverter}"  ConverterParameter="WriteRAM" >
                                                <Binding Path="CurrentChip" />
                                                <Binding Path="UserLicense" />
                                            </MultiBinding>
                                        </Path.Stroke>
                                    </Path>
                                </Canvas>
                                <Button.IsEnabled>
                                    <MultiBinding Converter="{StaticResource OperationEnableConverter}"  ConverterParameter="WriteRAM" >
                                        <Binding Path="CurrentChip" />
                                        <Binding Path="UserLicense" />
                                    </MultiBinding>
                                </Button.IsEnabled>
                            </Button>
                        </Grid>
